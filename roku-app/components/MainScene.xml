<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  
  <children>
    <!-- WebView for Curious Kelly -->
    <WebView
      id="webView"
      translation="[0,0]"
      width="1920"
      height="1080"
      url="https://curiouskelly.com"
      enableCookies="true"
      enableLocalStorage="true"
    />
    
    <!-- Loading indicator -->
    <BusySpinner
      id="loadingSpinner"
      translation="[860,490]"
      visible="true"
    />
  </children>
</component>







