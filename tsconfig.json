{
  "compilerOptions": {
    "target": "ES2022",
    // Vercel Node serverless executes /api/*.js as CommonJS. If we emit ESM,
    // it crashes with "SyntaxError: Unexpected token 'export'".
    // Keep the code authoring style (TS imports/exports) but ensure builds output CJS.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": ["@types/node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@lib/*": ["src/lib/*"],
      "@styles/*": ["styles/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": [
    "src/**/*",
    "functions/**/*",
    "api/**/*",
    "scripts/**/*",
    "tests/**/*",
    "astro.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "daily-lesson-marketing"
  ]
}

