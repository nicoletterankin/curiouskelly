{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kelly Expression Phase Mapping",
  "description": "Maps lesson phases to Kelly's facial expressions and emotional cues for avatar generation",
  "version": "1.0.0",
  "created": "2025-12-20",
  
  "phases": {
    "hook": {
      "emotion": "curious_excited",
      "energy": 0.85,
      "smile": 0.6,
      "eyebrows": "raised_interested",
      "gaze": {
        "direction": "direct_camera",
        "intensity": 0.9,
        "saccades": true
      },
      "movement": {
        "head_tilt": "slight_left",
        "nod_frequency": "occasional"
      },
      "voice_modulation": {
        "pitch_variance": 0.3,
        "speed": 1.1,
        "enthusiasm": 0.8
      },
      "description": "Kelly captures attention with genuine curiosity and warmth. Eyes bright, slight forward lean."
    },
    
    "cliff": {
      "emotion": "intrigued_questioning",
      "energy": 0.7,
      "smile": 0.3,
      "eyebrows": "one_raised",
      "gaze": {
        "direction": "direct_camera",
        "intensity": 0.85,
        "saccades": false
      },
      "movement": {
        "head_tilt": "slight_right",
        "nod_frequency": "none"
      },
      "voice_modulation": {
        "pitch_variance": 0.4,
        "speed": 0.95,
        "enthusiasm": 0.6
      },
      "description": "Kelly builds tension with a knowing look. 'Which path will you choose?' Her eyes hold the question."
    },
    
    "fact1": {
      "emotion": "explaining_confident",
      "energy": 0.75,
      "smile": 0.5,
      "eyebrows": "relaxed_attentive",
      "gaze": {
        "direction": "direct_camera",
        "intensity": 0.8,
        "saccades": true
      },
      "movement": {
        "head_tilt": "neutral",
        "nod_frequency": "regular"
      },
      "voice_modulation": {
        "pitch_variance": 0.2,
        "speed": 1.0,
        "enthusiasm": 0.7
      },
      "description": "Kelly delivers the first insight with confidence. Clear, direct, but warm."
    },
    
    "fact2": {
      "emotion": "building_momentum",
      "energy": 0.8,
      "smile": 0.55,
      "eyebrows": "slightly_raised",
      "gaze": {
        "direction": "direct_camera",
        "intensity": 0.85,
        "saccades": true
      },
      "movement": {
        "head_tilt": "slight_left",
        "nod_frequency": "regular"
      },
      "voice_modulation": {
        "pitch_variance": 0.25,
        "speed": 1.05,
        "enthusiasm": 0.75
      },
      "description": "Kelly deepens the lesson. Growing excitement as pieces connect."
    },
    
    "fact3": {
      "emotion": "revealing_application",
      "energy": 0.85,
      "smile": 0.65,
      "eyebrows": "engaged",
      "gaze": {
        "direction": "direct_camera",
        "intensity": 0.9,
        "saccades": true
      },
      "movement": {
        "head_tilt": "forward_lean",
        "nod_frequency": "emphatic"
      },
      "voice_modulation": {
        "pitch_variance": 0.3,
        "speed": 1.0,
        "enthusiasm": 0.85
      },
      "description": "Kelly shows real-world application. 'This is where it gets good!' Leaning in with excitement."
    },
    
    "wisdom": {
      "emotion": "warm_knowing",
      "energy": 0.7,
      "smile": 0.75,
      "eyebrows": "soft_raised",
      "gaze": {
        "direction": "direct_camera",
        "intensity": 0.95,
        "saccades": false
      },
      "movement": {
        "head_tilt": "slight_right",
        "nod_frequency": "slow_meaningful"
      },
      "voice_modulation": {
        "pitch_variance": 0.15,
        "speed": 0.9,
        "enthusiasm": 0.7
      },
      "description": "Kelly shares the wisdom. Slower pace, deeper connection. 'Remember this.' Eyes lock with learner."
    },
    
    "outro": {
      "emotion": "celebrating_proud",
      "energy": 0.9,
      "smile": 0.9,
      "eyebrows": "raised_happy",
      "gaze": {
        "direction": "direct_camera",
        "intensity": 0.95,
        "saccades": true
      },
      "movement": {
        "head_tilt": "slight_left",
        "nod_frequency": "enthusiastic"
      },
      "voice_modulation": {
        "pitch_variance": 0.35,
        "speed": 1.1,
        "enthusiasm": 0.95
      },
      "description": "Kelly celebrates completion. Big genuine smile, pride in learner. 'See you tomorrow!' Pure warmth."
    }
  },
  
  "micro_expressions": {
    "blink": {
      "rate_per_minute": {
        "min": 12,
        "max": 18
      },
      "duration_ms": {
        "min": 120,
        "max": 200
      },
      "rest_blink_probability": 0.1
    },
    "saccades": {
      "frequency_seconds": {
        "min": 1,
        "max": 3
      },
      "amplitude_degrees": {
        "min": 2,
        "max": 5
      }
    },
    "breathing": {
      "cycles_per_minute": {
        "min": 5,
        "max": 9
      },
      "visible_movement": "subtle_shoulders"
    },
    "head_coupling": {
      "with_gaze_shift": true,
      "amplitude_degrees": {
        "min": 1,
        "max": 2
      }
    }
  },
  
  "archetypes_that_shine": {
    "most_engaging": ["Scientist", "Empath", "Consultant"],
    "need_warmth_adjustment": ["Rebel", "Survivor", "MacGyver"],
    "best_for_wisdom_phase": ["Mystic", "Empath", "Scientist"],
    "best_for_energy_phases": ["Explorer", "Rebel", "Base"]
  },
  
  "notes": {
    "key_insight": "Kelly should direct with her eyes and smile - pointing with her lips toward the learning.",
    "uncanny_valley_fixes": [
      "Eyes must FIND the learner - direct gaze with micro-saccades",
      "Smile must be genuine - Duchenne smile (eyes + mouth together)",
      "Lips subtle direction during emphasis - slight pursing when pointing to key concepts",
      "Breathing and blinking must be natural - not mechanical"
    ],
    "generation_tips": [
      "Pre-process talking photos with gaze correction toward camera center",
      "Match archetype to lesson topic (Scientist for facts, Empath for emotional topics)",
      "Use phase-matched expression configs for HeyGen motion prompts",
      "Test with real learners for uncanny valley scoring (target >= 4.2/5)"
    ]
  }
}
