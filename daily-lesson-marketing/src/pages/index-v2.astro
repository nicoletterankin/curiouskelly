---
// Minimal Landing Page - Humble, Simple, Delightful
// This is the "lickable" redesign that can be A/B tested
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Learn something wonderful every day with Kelly, your AI teacher." />
    <title>Curious Kelly</title>

    <!-- Fonts: Instrument Sans (humble, readable, distinctive) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />

    <!-- OS Styles (Preloaded for seamless transition) -->
    <link rel="stylesheet" href="/lesson-player/css/styles.css" />
    <link rel="stylesheet" href="/lesson-player/css/ui-kit.css" />

    <!-- Supabase -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
      /* ============================================
         HUMBLE DESIGN SYSTEM
         Cool, minimal, delightful
         ============================================ */
      
      :root {
        /* Cool neutrals - not cold, not warm */
        --bg-deep: #09090b;
        --bg-surface: #0f0f12;
        --bg-elevated: #16161a;
        --bg-hover: #1c1c21;
        
        /* Text - soft, easy on eyes */
        --text-primary: #e4e4e7;
        --text-secondary: #a1a1aa;
        --text-tertiary: #71717a;
        --text-whisper: #52525b;
        
        /* Accent - muted sage green, unexpected but calming */
        --accent: #94a89a;
        --accent-dim: rgba(148, 168, 154, 0.15);
        --accent-glow: rgba(148, 168, 154, 0.08);
        
        /* Borders */
        --border: rgba(255, 255, 255, 0.06);
        --border-hover: rgba(255, 255, 255, 0.12);
        
        /* Typography */
        --font-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-serif: 'Newsreader', Georgia, serif;
        
        /* Spacing - generous breathing room */
        --space-xs: 4px;
        --space-sm: 8px;
        --space-md: 16px;
        --space-lg: 24px;
        --space-xl: 40px;
        --space-2xl: 64px;
        --space-3xl: 96px;
        
        /* Transitions */
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --duration: 0.4s;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        font-family: var(--font-sans);
        background: var(--bg-deep);
        color: var(--text-primary);
        min-height: 100vh;
        line-height: 1.6;
        overflow-x: hidden;
      }

      /* ============================================
         LANDING LAYER
         ============================================ */
      
      #landing {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: var(--bg-deep);
        display: flex;
        flex-direction: column;
        transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out);
      }

      #landing.hidden {
        opacity: 0;
        pointer-events: none;
        transform: scale(1.02);
      }

      /* ============================================
         HEADER - Minimal, confident
         ============================================ */
      
      .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        padding: var(--space-lg) var(--space-xl);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        font-weight: 600;
        font-size: 1rem;
        color: var(--text-primary);
        text-decoration: none;
        letter-spacing: -0.01em;
      }

      .logo-mark {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: var(--accent-dim);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
      }

      .header-right {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
      }

      .header-link {
        color: var(--text-tertiary);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: color var(--duration) var(--ease-out);
      }

      .header-link:hover {
        color: var(--text-primary);
      }

      /* ============================================
         HERO - The single focus
         ============================================ */
      
      .hero {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space-3xl) var(--space-xl);
        text-align: center;
        position: relative;
      }

      /* Subtle gradient backdrop */
      .hero::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 800px;
        height: 800px;
        background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
        pointer-events: none;
        opacity: 0.6;
      }

      /* Kelly container */
      .kelly-container {
        position: relative;
        margin-bottom: var(--space-2xl);
        z-index: 1;
      }

      .kelly-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--border);
        box-shadow: 0 0 60px var(--accent-glow);
        transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
      }

      .kelly-avatar:hover {
        transform: scale(1.05);
        box-shadow: 0 0 80px rgba(148, 168, 154, 0.15);
      }

      /* Speaking indicator */
      .kelly-speaking {
        position: absolute;
        bottom: -8px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 3px;
        padding: 6px 12px;
        background: var(--bg-elevated);
        border-radius: 20px;
        border: 1px solid var(--border);
      }

      .speaking-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--accent);
        animation: pulse 1.4s ease-in-out infinite;
      }

      .speaking-dot:nth-child(2) { animation-delay: 0.2s; }
      .speaking-dot:nth-child(3) { animation-delay: 0.4s; }

      @keyframes pulse {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.2); }
      }

      /* Typography */
      .hero-greeting {
        font-family: var(--font-serif);
        font-size: clamp(1rem, 2vw, 1.125rem);
        font-weight: 400;
        font-style: italic;
        color: var(--text-tertiary);
        margin-bottom: var(--space-md);
        opacity: 0;
        animation: fadeUp 0.8s var(--ease-out) 0.2s forwards;
      }

      .hero-title {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin-bottom: var(--space-lg);
        max-width: 600px;
        opacity: 0;
        animation: fadeUp 0.8s var(--ease-out) 0.4s forwards;
      }

      .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.125rem);
        color: var(--text-secondary);
        max-width: 420px;
        margin-bottom: var(--space-2xl);
        opacity: 0;
        animation: fadeUp 0.8s var(--ease-out) 0.6s forwards;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* CTA */
      .cta-group {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-md);
        opacity: 0;
        animation: fadeUp 0.8s var(--ease-out) 0.8s forwards;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-sm);
        padding: var(--space-md) var(--space-xl);
        background: var(--text-primary);
        color: var(--bg-deep);
        font-family: var(--font-sans);
        font-size: 0.9375rem;
        font-weight: 600;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: all var(--duration) var(--ease-out);
        min-width: 200px;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(228, 228, 231, 0.15);
      }

      .btn-primary:active {
        transform: translateY(0);
      }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: var(--space-sm);
        padding: var(--space-md) var(--space-lg);
        background: transparent;
        color: var(--text-secondary);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        transition: all var(--duration) var(--ease-out);
      }

      .btn-secondary:hover {
        border-color: var(--border-hover);
        color: var(--text-primary);
        background: var(--bg-hover);
      }

      .hint {
        font-size: 0.8125rem;
        color: var(--text-whisper);
        margin-top: var(--space-sm);
      }

      /* ============================================
         TODAY'S LESSON PREVIEW - Subtle, inviting
         ============================================ */
      
      .lesson-preview {
        position: absolute;
        bottom: var(--space-2xl);
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: var(--space-md);
        padding: var(--space-md) var(--space-lg);
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        cursor: pointer;
        transition: all var(--duration) var(--ease-out);
        opacity: 0;
        animation: fadeUp 0.8s var(--ease-out) 1s forwards;
      }

      .lesson-preview:hover {
        border-color: var(--border-hover);
        background: var(--bg-elevated);
        transform: translateX(-50%) translateY(-2px);
      }

      .lesson-preview-badge {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .lesson-preview-title {
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--text-primary);
      }

      .lesson-preview-arrow {
        color: var(--text-tertiary);
        transition: transform var(--duration) var(--ease-out);
      }

      .lesson-preview:hover .lesson-preview-arrow {
        transform: translateX(4px);
      }

      /* ============================================
         FOOTER - Minimal
         ============================================ */
      
      .footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        padding: var(--space-lg) var(--space-xl);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--text-whisper);
      }

      .footer a {
        color: var(--text-tertiary);
        text-decoration: none;
        transition: color var(--duration) var(--ease-out);
      }

      .footer a:hover {
        color: var(--text-secondary);
      }

      .footer-links {
        display: flex;
        gap: var(--space-lg);
      }

      /* ============================================
         MOBILE RESPONSIVE
         ============================================ */
      
      @media (max-width: 768px) {
        .header {
          padding: var(--space-md);
        }

        .header-link {
          display: none;
        }

        .hero {
          padding: var(--space-2xl) var(--space-lg);
        }

        .kelly-avatar {
          width: 120px;
          height: 120px;
        }

        .lesson-preview {
          left: var(--space-md);
          right: var(--space-md);
          transform: none;
          bottom: calc(var(--space-3xl) + var(--space-lg));
        }

        .lesson-preview:hover {
          transform: translateY(-2px);
        }

        .footer {
          flex-direction: column;
          gap: var(--space-sm);
          padding: var(--space-md);
        }
      }

      /* ============================================
         LOADING STATE
         ============================================ */
      
      .btn-primary.loading {
        pointer-events: none;
        opacity: 0.8;
      }

      .btn-primary.loading .btn-text {
        opacity: 0;
      }

      .spinner {
        position: absolute;
        width: 18px;
        height: 18px;
        border: 2px solid transparent;
        border-top-color: var(--bg-deep);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        display: none;
      }

      .btn-primary.loading .spinner {
        display: block;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      /* ============================================
         HIDDEN OS LAYER (preloaded)
         ============================================ */
      
      #app-layer-desktop {
        position: fixed;
        inset: 0;
        z-index: 1;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.6s var(--ease-out);
      }

      #app-layer-desktop.active {
        opacity: 1;
        pointer-events: auto;
      }
    </style>
  </head>

  <body>
    <!-- ============================================
         LANDING - The humble, delightful entry
         ============================================ -->
    <div id="landing">
      <!-- Header -->
      <header class="header">
        <a href="/" class="logo">
          <span class="logo-mark">✨</span>
          Curious Kelly
        </a>
        <div class="header-right">
          <a href="#curriculum" class="header-link">Curriculum</a>
          <a href="#pricing" class="header-link">Pricing</a>
          <button class="btn-secondary" onclick="handleSignIn()">Sign in</button>
        </div>
      </header>

      <!-- Hero -->
      <main class="hero">
        <!-- Kelly -->
        <div class="kelly-container">
          <img 
            src="/assets/kelly/production/hero/kelly-hero-mobile.webp" 
            alt="Kelly" 
            class="kelly-avatar"
            onerror="this.src='/images/brand/kelly-mark-circle-64.png'"
          />
          <div class="kelly-speaking">
            <span class="speaking-dot"></span>
            <span class="speaking-dot"></span>
            <span class="speaking-dot"></span>
          </div>
        </div>

        <!-- Copy -->
        <p class="hero-greeting">Hi, I'm Kelly</p>
        <h1 class="hero-title">Learn something wonderful every day</h1>
        <p class="hero-subtitle">
          Five minutes a day. One topic. 
          Adapted just for you.
        </p>

        <!-- CTA -->
        <div class="cta-group">
          <button class="btn-primary" onclick="handleStart(this)">
            <span class="btn-text">Start today's lesson</span>
            <span class="spinner"></span>
          </button>
          <p class="hint">No account needed</p>
        </div>

        <!-- Today's lesson teaser -->
        <div class="lesson-preview" onclick="handleStart(document.querySelector('.btn-primary'))">
          <span class="lesson-preview-badge">Today</span>
          <span class="lesson-preview-title" id="today-topic">Loading...</span>
          <span class="lesson-preview-arrow">→</span>
        </div>
      </main>

      <!-- Footer -->
      <footer class="footer">
        <span>© 2025 Lesson of the Day PBC</span>
        <div class="footer-links">
          <a href="/privacy.html">Privacy</a>
          <a href="/terms.html">Terms</a>
          <a href="mailto:hello@curiouskelly.com">Contact</a>
        </div>
      </footer>
    </div>

    <!-- ============================================
         OS LAYER (Hidden, preloaded)
         ============================================ -->
    <div id="app-layer-desktop">
      <div id="layer-background">
        <div class="kelly-unity-container" id="kelly-unity-container">
          <iframe
            id="kelly-unity-iframe"
            class="kelly-unity-iframe"
            src="/unity/kelly-v1/index.html"
            title="Kelly Unity Avatar"
            allow="autoplay; microphone; fullscreen"
            loading="lazy"
          ></iframe>
        </div>
        <img
          id="kelly-image"
          class="kelly-image"
          src="/kelly/choices/choice_right.png"
          alt="Kelly teaching"
        />
      </div>

      <button id="os-trigger" title="Menu">☰</button>

      <div id="layer-os-interface">
        <div id="mode-dashboard" class="os-mode-panel active"></div>
        <div id="mode-lesson" class="os-mode-panel">
          <div class="controls-panel">
            <div class="age-selector-floating glass-panel-light">
              <label for="age-slider" class="age-label-floating">Age</label>
              <div class="age-display-floating"><span id="age-value">25</span></div>
              <input type="range" id="age-slider" min="2" max="102" value="25" class="age-slider-floating" />
            </div>
          </div>
          <aside class="lesson-context-panel glass-panel-medium">
            <div class="lesson-meta-header"><div class="meta-label">Current Lesson</div></div>
            <h2 id="lesson-title" class="lesson-title">Loading...</h2>
            <p id="topic-description" class="lesson-description">...</p>
          </aside>
          <div class="interaction-zone">
            <div id="question-card" class="question-card glass-panel-medium">
              <button id="play-pause" class="play-button glass-panel-light"><span class="play-icon">▶</span></button>
              <div id="question-text" class="question-text">Ready?</div>
            </div>
            <div id="choice-cards-container" class="choice-cards-container"></div>
          </div>
        </div>
      </div>

      <div id="layer-modal-stack">
        <div id="menu-drawer" class="glass-drawer">
          <div class="drawer-header">
            <h3>Kelly</h3>
            <button class="btn-close-drawer">×</button>
          </div>
          <div class="drawer-content-scroll">
            <nav class="drawer-nav">
              <button class="drawer-item active" data-target="mode-lesson">
                <span class="icon">📚</span> Today's Lesson
              </button>
              <button class="drawer-item" data-action="open-syllabus">
                <span class="icon">📅</span> Curriculum
              </button>
              <button class="drawer-item" data-action="open-tuition">
                <span class="icon">✨</span> Upgrade
              </button>
            </nav>
            <div class="drawer-divider"></div>
            <nav class="drawer-nav">
              <button class="drawer-item" data-action="open-settings">Settings</button>
              <button class="drawer-item text-danger" onclick="window.location.reload()">Log Out</button>
            </nav>
          </div>
        </div>

        <div id="modal-tuition" class="os-modal glass-panel-heavy">
          <div class="modal-header">
            <h2>Upgrade</h2>
            <button class="btn-close-modal">Close</button>
          </div>
          <div class="modal-content-scroll">
            <div class="pricing-grid">
              <div class="pricing-card glass-panel-light">
                <h3>Monthly</h3>
                <div class="price">$9.99<span>/month</span></div>
                <button class="btn-primary-glass btn-checkout" data-plan="monthly">Subscribe</button>
              </div>
              <div class="pricing-card glass-panel-light featured">
                <h3>Annual</h3>
                <div class="price">$99<span>/year</span></div>
                <button class="btn-primary-glass btn-checkout" data-plan="annual">Subscribe</button>
              </div>
            </div>
          </div>
        </div>

        <div id="modal-reader" class="os-modal glass-panel-heavy">
          <div class="modal-header">
            <h2 id="reader-title">Title</h2>
            <button class="btn-close-modal">Close</button>
          </div>
          <div class="modal-content-scroll" id="reader-content"></div>
        </div>
      </div>
    </div>

    <audio id="kelly-audio" preload="auto"></audio>

    <!-- App JS -->
    <script type="module" src="/lesson-player/js/app.js"></script>

    <!-- Landing Logic -->
    <script is:inline define:vars={{
      supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL || 'https://tvjalxxsyryjphkforjv.supabase.co',
      supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '',
    }}>
      // ============================================
      // MINIMAL AUTH & TRANSITION
      // ============================================

      let supabase = null;
      if (window.supabase && supabaseUrl && supabaseKey) {
        supabase = window.supabase.createClient(supabaseUrl, supabaseKey, {
          auth: { autoRefreshToken: true, persistSession: true, detectSessionInUrl: true }
        });
      }

      // Load today's topic
      async function loadTodaysTopic() {
        try {
          const dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);
          if (supabase) {
            const { data } = await supabase
              .from('core_lessons')
              .select('topic')
              .eq('day_number', dayOfYear)
              .single();
            if (data) {
              document.getElementById('today-topic').textContent = data.topic;
            }
          }
        } catch (e) {
          document.getElementById('today-topic').textContent = 'How the sun powers life';
        }
      }

      // Check existing session
      async function checkSession() {
        if (!supabase) return null;
        const { data: { session } } = await supabase.auth.getSession();
        if (session?.user) {
          transitionToOS(session.user);
          return session.user;
        }
        return null;
      }

      // Transition to OS
      function transitionToOS(user) {
        const landing = document.getElementById('landing');
        const os = document.getElementById('app-layer-desktop');

        landing.classList.add('hidden');
        os.classList.add('active');

        setTimeout(() => {
          landing.style.display = 'none';
        }, 600);

        if (window.os) {
          window.os.switchMode('lesson');
          if (window.os.state) window.os.state.user = user;
        }
      }

      // Handle start (guest mode)
      window.handleStart = function(btn) {
        btn.classList.add('loading');

        // Guest mode - instant access
        localStorage.setItem('curious-kelly-guest', 'true');
        
        const guestUser = {
          id: 'guest-' + Date.now(),
          email: null,
          isGuest: true,
          user_metadata: { full_name: 'Explorer' }
        };

        setTimeout(() => {
          transitionToOS(guestUser);
        }, 400);
      };

      // Handle sign in
      window.handleSignIn = async function() {
        if (!supabase) {
          alert('Sign in is not configured yet. Use "Start today\'s lesson" to begin!');
          return;
        }
        
        await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: { redirectTo: window.location.origin + '/' }
        });
      };

      // Export for OS
      window.CuriousKellyAuth = {
        supabase,
        getUser: () => null,
        signOut: async () => {
          if (supabase) await supabase.auth.signOut();
          localStorage.removeItem('curious-kelly-guest');
          window.location.reload();
        },
        isGuest: () => localStorage.getItem('curious-kelly-guest') === 'true'
      };

      // Init
      document.addEventListener('DOMContentLoaded', () => {
        loadTodaysTopic();
        checkSession();
      });

      // Auth state listener
      if (supabase) {
        supabase.auth.onAuthStateChange((event, session) => {
          if (event === 'SIGNED_IN' && session?.user) {
            transitionToOS(session.user);
          }
        });
      }
    </script>
  </body>
</html>

