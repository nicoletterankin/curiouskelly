---
import '../styles/unified-design-system.scss';
// Curious Kelly - Minimal Landing Page
// Unified Aquarium: Layer 1 (Landing) + Layer 2 (Kelly OS)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>The Daily Lesson — Kelly for your classroom</title>
    <meta
      name="description"
      content="The Daily Lesson gives every classroom a five‑minute, AI-powered micro-lesson each morning. Kelly adapts to your age band while keeping schools in control."
    />
    <meta
      name="keywords"
      content="school SEL curriculum, daily lesson, AI teacher, classroom routines, emotional intelligence for students, morning meeting, The Daily Lesson"
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Lesson of the Day PBC" />
    <meta name="theme-color" content="#2563eb" />

    <!-- Canonical -->
    <link rel="canonical" href="https://thedailylesson.com/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Daily Lesson" />
    <meta property="og:url" content="https://thedailylesson.com/" />
    <meta
      property="og:title"
      content="The Daily Lesson — Kelly for your classroom"
    />
    <meta
      property="og:description"
      content="Five-minute, AI-powered lessons that help every student start the day calm, curious, and ready to learn."
    />
    <meta
      property="og:image"
      content="https://thedailylesson.com/images/social/daily-lesson-og.png"
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="The Daily Lesson — Kelly for your classroom"
    />
    <meta
      name="twitter:description"
      content="Five-minute, AI-powered lessons that help every student start the day calm, curious, and ready to learn."
    />
    <meta
      name="twitter:image"
      content="https://thedailylesson.com/images/social/daily-lesson-og.png"
    />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "The Daily Lesson",
        "url": "https://thedailylesson.com",
        "description": "Daily five-minute AI-powered lessons for classrooms, aligned with social-emotional learning and modern life skills.",
        "logo": "https://thedailylesson.com/images/brand/daily-lesson-logo.png",
        "parentOrganization": {
          "@type": "Organization",
          "name": "Lesson of the Day PBC",
          "url": "https://lessonoftheday.com"
        },
        "founder": {
          "@type": "Person",
          "name": "Nicolette"
        },
        "areaServed": "Worldwide",
        "audience": {
          "@type": "EducationalAudience",
          "educationalRole": "student",
          "audienceType": "K‑12 classrooms"
        }
      }
    </script>

    <!-- Fonts: Instrument Sans + Newsreader -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />

    <!-- OS Styles (Preloaded for seamless transition) -->
    <link rel="stylesheet" href="/lesson-player/css/styles.css" />
    <link rel="stylesheet" href="/lesson-player/css/ui-kit.css" />

    <!-- Supabase -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
      /* ============================================
         CURIOUS KELLY DESIGN SYSTEM
         Black/White/Blue — Humble, Simple, Delightful
         ============================================ */
      
      :root {
        /* Core palette */
        --black: #09090b;
        --black-soft: #18181b;
        --black-muted: #27272a;
        
        --white: #fafafa;
        --white-soft: #f4f4f5;
        --white-muted: #e4e4e7;
        
        /* Blue accent */
        --blue: #3b82f6;
        --blue-soft: #60a5fa;
        --blue-dim: rgba(59, 130, 246, 0.1);
        --blue-glow: rgba(59, 130, 246, 0.06);
        
        /* Alerts only */
        --alert-orange: #f97316;
        --alert-yellow: #eab308;
        --success: #22c55e;
        --error: #ef4444;
        
        /* Text hierarchy */
        --text-1: #fafafa;
        --text-2: #a1a1aa;
        --text-3: #71717a;
        --text-4: #52525b;
        
        /* Borders */
        --border: rgba(255, 255, 255, 0.08);
        --border-hover: rgba(255, 255, 255, 0.15);
        
        /* Typography */
        --font-sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-serif: 'Newsreader', Georgia, serif;
        
        /* Spacing */
        --space-xs: 4px;
        --space-sm: 8px;
        --space-md: 16px;
        --space-lg: 24px;
        --space-xl: 40px;
        --space-2xl: 64px;
        --space-3xl: 96px;
        --space-4xl: 128px;
        
        /* Layout */
        --max-width: 1200px;
        --header-height: 64px;
        
        /* Transitions */
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --duration: 0.3s;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background: var(--black);
        color: var(--text-1);
        line-height: 1.6;
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* ============================================
         LAYER 1: LANDING (z-index 1000)
         ============================================ */
      
      #landing-layer {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: var(--black);
        overflow-y: auto;
        overflow-x: hidden;
        transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
      }

      #landing-layer.hidden {
        opacity: 0;
        pointer-events: none;
        transform: scale(1.02);
      }

      /* ============================================
         HEADER
         ============================================ */
      
      .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        height: var(--header-height);
        background: rgba(9, 9, 11, 0.8);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }

      .header-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 var(--space-lg);
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        font-weight: 600;
        font-size: 1rem;
        letter-spacing: -0.01em;
      }

      .logo-mark {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--blue-dim);
        border: 1px solid rgba(59, 130, 246, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: var(--space-xl);
      }

      .nav-links {
        display: flex;
        gap: var(--space-lg);
      }

      .nav-link {
        color: var(--text-3);
        font-size: 0.875rem;
        font-weight: 500;
        transition: color var(--duration) var(--ease);
      }

      .nav-link:hover {
        color: var(--text-1);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: var(--space-md);
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-sm);
        padding: 10px 20px;
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 8px;
        cursor: pointer;
        transition: all var(--duration) var(--ease);
        border: none;
      }

      .btn-ghost {
        background: transparent;
        color: var(--text-2);
      }

      .btn-ghost:hover {
        color: var(--text-1);
        background: var(--black-soft);
      }

      .btn-outline {
        background: transparent;
        color: var(--text-1);
        border: 1px solid var(--border);
      }

      .btn-outline:hover {
        border-color: var(--border-hover);
        background: var(--black-soft);
      }

      .btn-primary {
        background: var(--white);
        color: var(--black);
        font-weight: 600;
      }

      .btn-primary:hover {
        background: var(--white-soft);
        transform: translateY(-1px);
      }

      .btn-blue {
        background: var(--blue);
        color: white;
        font-weight: 600;
      }

      .btn-blue:hover {
        background: var(--blue-soft);
        transform: translateY(-1px);
      }

      .btn.loading {
        pointer-events: none;
        opacity: 0.7;
      }

      .spinner {
        width: 16px;
        height: 16px;
        border: 2px solid transparent;
        border-top-color: currentColor;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        display: none;
      }

      .btn.loading .spinner {
        display: block;
      }

      .btn.loading .btn-text {
        opacity: 0;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      /* ============================================
         HERO
         ============================================ */
      
      .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space-4xl) var(--space-lg);
        text-align: center;
        position: relative;
      }

      .hero::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -60%);
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, var(--blue-glow) 0%, transparent 70%);
        pointer-events: none;
      }

      .kelly-container {
        position: relative;
        margin-bottom: var(--space-xl);
        z-index: 1;
      }

      .kelly-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: linear-gradient(145deg, var(--black-soft), var(--black));
        border: 1px solid var(--border);
        box-shadow: 0 0 80px var(--blue-glow);
        overflow: hidden;
        transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease);
      }

      .kelly-avatar:hover {
        transform: scale(1.05);
        box-shadow: 0 0 100px rgba(59, 130, 246, 0.1);
      }

      .kelly-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
      }

      .kelly-status {
        position: absolute;
        bottom: -6px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 3px;
        padding: 6px 12px;
        background: var(--black-soft);
        border-radius: 20px;
        border: 1px solid var(--border);
      }

      .status-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--blue);
        animation: pulse 1.4s ease-in-out infinite;
      }

      .status-dot:nth-child(2) { animation-delay: 0.2s; }
      .status-dot:nth-child(3) { animation-delay: 0.4s; }

      @keyframes pulse {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.3); }
      }

      .hero-greeting {
        font-family: var(--font-serif);
        font-size: 1.125rem;
        font-style: italic;
        color: var(--text-3);
        margin-bottom: var(--space-md);
      }

      .hero-title {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
        margin-bottom: var(--space-lg);
        max-width: 700px;
      }

      .hero-subtitle {
        font-size: 1.25rem;
        color: var(--text-2);
        max-width: 500px;
        margin-bottom: var(--space-2xl);
      }

      .hero-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-md);
      }

      .hero-cta .btn-primary {
        padding: 14px 32px;
        font-size: 1rem;
        border-radius: 12px;
        position: relative;
      }

      .hero-hint {
        font-size: 0.8125rem;
        color: var(--text-4);
      }

      .scroll-hint {
        position: absolute;
        bottom: var(--space-xl);
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-sm);
        color: var(--text-4);
        font-size: 0.75rem;
        animation: float 2s ease-in-out infinite;
      }

      @keyframes float {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50% { transform: translateX(-50%) translateY(8px); }
      }

      /* Fade-in animations */
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .fade-in { animation: fadeIn 0.8s var(--ease) forwards; }
      .fade-in-1 { animation-delay: 0.1s; }
      .fade-in-2 { animation-delay: 0.2s; }
      .fade-in-3 { animation-delay: 0.3s; }
      .fade-in-4 { animation-delay: 0.4s; }
      .fade-in-5 { animation-delay: 0.5s; }

      /* ============================================
         SECTIONS
         ============================================ */
      
      .section {
        padding: var(--space-4xl) var(--space-lg);
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .section-header {
        text-align: center;
        margin-bottom: var(--space-3xl);
      }

      .section-label {
        display: inline-block;
        padding: 6px 14px;
        background: var(--blue-dim);
        border: 1px solid rgba(59, 130, 246, 0.2);
        border-radius: 100px;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--blue-soft);
        margin-bottom: var(--space-md);
        letter-spacing: 0.02em;
      }

      .section-title {
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: var(--space-md);
      }

      .section-subtitle {
        font-size: 1.125rem;
        color: var(--text-2);
        max-width: 600px;
        margin: 0 auto;
      }

      /* How it works */
      .how-it-works {
        background: var(--black-soft);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-xl);
      }

      .step {
        text-align: center;
        padding: var(--space-xl);
      }

      .step-number {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--blue-dim);
        border: 1px solid rgba(59, 130, 246, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--blue-soft);
        margin: 0 auto var(--space-lg);
      }

      .step-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: var(--space-sm);
      }

      .step-desc {
        color: var(--text-2);
        font-size: 0.9375rem;
      }

      /* Today's lesson preview */
      .today-preview {
        background: var(--black);
      }

      .lesson-card {
        background: var(--black-soft);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: var(--space-2xl);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-2xl);
        align-items: center;
        transition: border-color var(--duration) var(--ease);
      }

      .lesson-card:hover {
        border-color: var(--border-hover);
      }

      .lesson-visual {
        aspect-ratio: 16/9;
        background: linear-gradient(135deg, var(--blue-dim), var(--black));
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        overflow: hidden;
      }

      .lesson-visual img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .lesson-badge {
        display: inline-block;
        padding: 4px 10px;
        background: var(--blue-dim);
        border-radius: 100px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--blue-soft);
        margin-bottom: var(--space-md);
      }

      .lesson-title {
        font-family: var(--font-serif);
        font-size: 2rem;
        font-weight: 500;
        margin-bottom: var(--space-md);
        letter-spacing: -0.01em;
      }

      .lesson-hook {
        font-size: 1.125rem;
        color: var(--text-2);
        font-style: italic;
        margin-bottom: var(--space-lg);
      }

      .lesson-meta {
        display: flex;
        gap: var(--space-lg);
        margin-bottom: var(--space-xl);
        font-size: 0.875rem;
        color: var(--text-3);
      }

      /* Features */
      .features {
        background: var(--black-soft);
        border-top: 1px solid var(--border);
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-lg);
      }

      .feature {
        padding: var(--space-xl);
        background: var(--black);
        border: 1px solid var(--border);
        border-radius: 16px;
        transition: border-color var(--duration) var(--ease);
      }

      .feature:hover {
        border-color: var(--border-hover);
      }

      .feature-icon {
        font-size: 2rem;
        margin-bottom: var(--space-md);
      }

      .feature-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: var(--space-sm);
      }

      .feature-desc {
        color: var(--text-2);
        font-size: 0.9375rem;
      }

      /* Pricing */
      .pricing-teaser {
        background: var(--black);
        border-bottom: 1px solid var(--border);
      }

      .pricing-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-lg);
      }

      .price-card {
        padding: var(--space-xl);
        background: var(--black-soft);
        border: 1px solid var(--border);
        border-radius: 16px;
        text-align: center;
        transition: all var(--duration) var(--ease);
      }

      .price-card:hover {
        border-color: var(--border-hover);
        transform: translateY(-4px);
      }

      .price-card.featured {
        border-color: var(--blue);
        background: linear-gradient(180deg, rgba(59, 130, 246, 0.05) 0%, var(--black-soft) 100%);
      }

      .price-name {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: var(--space-sm);
      }

      .price-amount {
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: var(--space-xs);
      }

      .price-amount span {
        font-size: 1rem;
        color: var(--text-3);
        font-weight: 400;
      }

      .price-desc {
        color: var(--text-3);
        font-size: 0.875rem;
        margin-bottom: var(--space-lg);
      }

      /* Final CTA */
      .final-cta {
        background: var(--black);
        text-align: center;
        padding: var(--space-4xl) var(--space-lg);
      }

      .final-cta .section-title {
        margin-bottom: var(--space-xl);
      }

      /* ============================================
         FOOTER
         ============================================ */
      
      .footer {
        background: var(--black);
        border-top: 1px solid var(--border);
        padding: var(--space-3xl) var(--space-lg) var(--space-xl);
      }

      .footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr repeat(4, 1fr);
        gap: var(--space-2xl);
        margin-bottom: var(--space-3xl);
      }

      .footer-brand {
        max-width: 280px;
      }

      .footer-brand .logo {
        margin-bottom: var(--space-md);
      }

      .footer-brand p {
        color: var(--text-3);
        font-size: 0.875rem;
        margin-bottom: var(--space-lg);
      }

      .footer-social {
        display: flex;
        gap: var(--space-md);
      }

      .social-link {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: var(--black-soft);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-3);
        font-size: 0.875rem;
        transition: all var(--duration) var(--ease);
      }

      .social-link:hover {
        border-color: var(--border-hover);
        color: var(--text-1);
      }

      .footer-col h4 {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text-1);
        margin-bottom: var(--space-lg);
        letter-spacing: 0.02em;
      }

      .footer-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      .footer-links a {
        color: var(--text-3);
        font-size: 0.875rem;
        transition: color var(--duration) var(--ease);
      }

      .footer-links a:hover {
        color: var(--text-1);
      }

      .footer-bottom {
        padding-top: var(--space-xl);
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8125rem;
        color: var(--text-4);
      }

      .footer-legal {
        display: flex;
        gap: var(--space-lg);
      }

      .footer-legal a {
        color: var(--text-4);
        transition: color var(--duration) var(--ease);
      }

      .footer-legal a:hover {
        color: var(--text-2);
      }

      /* ============================================
         RESPONSIVE
         ============================================ */
      
      @media (max-width: 1024px) {
        .steps {
          grid-template-columns: 1fr;
          gap: var(--space-lg);
        }

        .lesson-card {
          grid-template-columns: 1fr;
        }

        .features-grid {
          grid-template-columns: 1fr;
        }

        .pricing-cards {
          grid-template-columns: 1fr;
        }

        .footer-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

