    <!-- Landing + Auth Logic -->
    <script is:inline define:vars={{
      supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL || 'https://tvjalxxsyryjphkforjv.supabase.co',
      supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '',
    }}>
      // ============================================
      // CURIOUS KELLY - AUTH & TRANSITIONS
      // ============================================

      let supabase = null;
      let currentUser = null;
      let isProcessing = false;

      // Initialize Supabase
      if (window.supabase && supabaseUrl && supabaseKey) {
        supabase = window.supabase.createClient(supabaseUrl, supabaseKey, {
          auth: {
            autoRefreshToken: true,
            persistSession: true,
            detectSessionInUrl: true,
            storageKey: 'curious-kelly-auth',
            flowType: 'pkce',
          },
        });
        console.log('✅ Supabase initialized');
      }

      // ============================================
      // SESSION CHECK
      // ============================================

      async function checkSession() {
        if (!supabase) return null;

        try {
          const hash = window.location.hash;
          if (hash && (hash.includes('access_token') || hash.includes('error'))) {
            if (hash.includes('error')) {
              const params = new URLSearchParams(hash.substring(1));
              const error = params.get('error_description') || params.get('error');
              showToast(error || 'Login failed', 'error');
              history.replaceState(null, '', window.location.pathname);
              return null;
            }
            await new Promise(resolve => setTimeout(resolve, 100));
          }

          const { data: { session }, error } = await supabase.auth.getSession();
          
          if (session?.user) {
            currentUser = session.user;
            if (window.location.hash) {
              history.replaceState(null, '', window.location.pathname);
            }
            transitionToOS(session.user);
            return session.user;
          }
        } catch (err) {
          console.error('Session check failed:', err);
        }
        return null;
      }

      // ============================================
      // TRANSITION TO OS
      // ============================================

      function transitionToOS(user) {
        const landing = document.getElementById('landing-layer');
        const os = document.getElementById('app-layer-desktop');

        currentUser = user;
        landing.classList.add('hidden');
        os.classList.add('active');

        setTimeout(() => {
          landing.style.display = 'none';
        }, 600);

        if (window.os) {
          window.os.switchMode('lesson');
          if (window.os.state) window.os.state.user = user;
        }
      }

      // ============================================
      // AUTH HANDLERS
      // ============================================

      window.handleStart = function(btn) {
        if (isProcessing) return;
        isProcessing = true;
        
        if (btn) btn.classList.add('loading');

        // Guest mode - instant access
        localStorage.setItem('curious-kelly-guest', 'true');
        localStorage.setItem('curious-kelly-guest-started', new Date().toISOString());

        const guestUser = {
          id: 'guest-' + Date.now(),
          email: null,
          isGuest: true,
          user_metadata: { full_name: 'Explorer' }
        };

        setTimeout(() => {
          transitionToOS(guestUser);
          isProcessing = false;
        }, 400);
      };

      window.handleSignIn = async function() {
        if (!supabase) {
          showToast('Sign in not configured. Use "Start learning" to begin!', 'info');
          return;
        }

        await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: window.location.origin + '/',
            queryParams: { access_type: 'offline', prompt: 'consent' }
          }
        });
      };

      window.handleCheckout = async function(plan) {
        try {
          const response = await fetch('/api/create-checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ plan, email: currentUser?.email || '' })
          });
          const data = await response.json();
          if (data.url) window.location.href = data.url;
        } catch (err) {
          showToast('Checkout failed. Please try again.', 'error');
        }
      };

      // ============================================
      // TOAST NOTIFICATIONS
      // ============================================

      function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        const colors = {
          info: 'var(--blue)',
          error: 'var(--error)',
          success: 'var(--success)'
        };
        toast.style.cssText = `
          position: fixed;
          top: 20px;
          left: 50%;
          transform: translateX(-50%);
          background: ${colors[type]};
          color: white;
          padding: 12px 24px;
          border-radius: 8px;
          font-size: 14px;
          z-index: 9999;
          animation: fadeIn 0.3s ease;
        `;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
      }

      // ============================================
      // LOAD TODAY'S LESSON
      // ============================================

      async function loadTodaysLesson() {
        try {
          const dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);
          
          if (supabase) {
            const { data } = await supabase
              .from('core_lessons')
              .select('day_number, topic, marketing_headline')
              .eq('day_number', dayOfYear)
              .single();

            if (data) {
              document.getElementById('today-topic').textContent = data.topic;
              document.getElementById('today-day-badge').textContent = `Day ${data.day_number} of 366`;
              if (data.marketing_headline) {
                document.getElementById('today-hook').textContent = `"${data.marketing_headline}"`;
              }
            }
          }
        } catch (e) {
          console.log('Using default lesson data');
        }
      }

      // ============================================
      // PARALLAX EFFECT
      // ============================================

      function setupParallax() {
        const kelly = document.getElementById('kelly');
        const hero = document.querySelector('.hero');

        if (kelly && hero) {
          hero.addEventListener('mousemove', (e) => {
            const rect = kelly.getBoundingClientRect();
            const centerX = rect.left + rect.width / 2;
            const centerY = rect.top + rect.height / 2;
            const deltaX = (e.clientX - centerX) / 50;
            const deltaY = (e.clientY - centerY) / 50;
            kelly.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
          });

          hero.addEventListener('mouseleave', () => {
            kelly.style.transform = 'translate(0, 0)';
          });
        }
      }

      // ============================================
      // AUTH STATE LISTENER
      // ============================================

      if (supabase) {
        supabase.auth.onAuthStateChange((event, session) => {
          if (event === 'SIGNED_IN' && session?.user) {
            transitionToOS(session.user);
          }
        });
      }

      // ============================================
      // EXPORT FOR OS
      // ============================================

      window.CuriousKellyAuth = {
        supabase,
        getUser: () => currentUser,
        signOut: async () => {
          if (supabase) await supabase.auth.signOut();
          localStorage.removeItem('curious-kelly-guest');
          window.location.reload();
        },
        isGuest: () => currentUser?.isGuest || localStorage.getItem('curious-kelly-guest') === 'true',
        isAuthenticated: () => !!currentUser && !currentUser.isGuest,
      };

      // ============================================
      // INITIALIZE
      // ============================================

      document.addEventListener('DOMContentLoaded', () => {
        checkSession();
        loadTodaysLesson();
        setupParallax();
      });
    </script>
