    <!-- Production Auth System -->
    <script
      is:inline
      define:vars={{
        supabaseUrl:
          import.meta.env.PUBLIC_SUPABASE_URL || 'https://tvjalxxsyryjphkforjv.supabase.co',
        supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '',
      }}
    >
      // ============================================
      // CURIOUS KELLY - PRODUCTION AUTH
      // Zero friction, instant learning
      // ============================================

      // Initialize Supabase (uses CDN loaded above)
      let supabase = null;

      if (window.supabase && supabaseUrl && supabaseKey) {
        supabase = window.supabase.createClient(supabaseUrl, supabaseKey, {
          auth: {
            autoRefreshToken: true,
            persistSession: true,
            detectSessionInUrl: true,
            storageKey: 'curious-kelly-auth',
            flowType: 'pkce',
          },
        });
        console.log('✅ Supabase initialized');
      } else {
        console.warn(
          '⚠️ Supabase not configured - auth will not work. Set PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY'
        );
      }

      // ============================================
      // STATE
      // ============================================

      let currentUser = null;
      let isProcessing = false;

      // ============================================
      // CHECK SESSION ON LOAD
      // ============================================

      async function checkSession() {
        try {
          // Check for OAuth callback (hash contains access_token)
          const hash = window.location.hash;
          if (hash && (hash.includes('access_token') || hash.includes('error'))) {
            console.log('Processing OAuth callback...');

            // Parse error if present
            if (hash.includes('error')) {
              const params = new URLSearchParams(hash.substring(1));
              const error = params.get('error_description') || params.get('error');
              console.error('OAuth error:', error);
              showAuthError(error);
              // Clean up URL
              history.replaceState(null, '', window.location.pathname);
              return null;
            }

            // Let Supabase process the tokens
            // Wait a moment for Supabase to handle the callback
            await new Promise(resolve => setTimeout(resolve, 100));
          }

          const {
            data: { session },
            error,
          } = await supabase.auth.getSession();

          if (error) {
            console.error('Session check error:', error);
            return null;
          }

          if (session?.user) {
            currentUser = session.user;
            console.log('✅ User authenticated:', session.user.email);

            // Clean up URL hash if present (removes tokens from URL bar)
            if (window.location.hash) {
              history.replaceState(null, '', window.location.pathname);
            }

            // Auto-transition to OS for authenticated users
            transitionToOS(session.user);
            return session.user;
          }

          return null;
        } catch (err) {
          console.error('Session check failed:', err);
          return null;
        }
      }

      // Show auth error to user
      function showAuthError(message) {
        const toast = document.createElement('div');
        toast.style.cssText = `
                position: fixed;
                top: 20px;
                left: 50%;
                transform: translateX(-50%);
                background: #ef4444;
                color: white;
                padding: 16px 24px;
                border-radius: 8px;
                font-size: 14px;
                z-index: 9999;
                max-width: 400px;
                text-align: center;
            `;
        toast.textContent = message || 'Login failed. Please try again.';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 5000);
      }

      // ============================================
      // AUTH STATE LISTENER
      // ============================================

      supabase.auth.onAuthStateChange((event, session) => {
        console.log('Auth event:', event);

        if (event === 'SIGNED_IN' && session?.user) {
          currentUser = session.user;
          transitionToOS(session.user);
        } else if (event === 'SIGNED_OUT') {
          currentUser = null;
          // Could show login layer again here
        }
      });

      // ============================================
      // TRANSITION TO OS
      // ============================================

      function transitionToOS(user) {
        const loginLayer = document.getElementById('login-layer');
        const osLayer = document.getElementById('app-layer-desktop');

        // Update any user display elements
        if (user?.email) {
          const userDisplays = document.querySelectorAll('[data-user-email]');
          userDisplays.forEach(el => (el.textContent = user.email));
        }

        // Fade out Login
        loginLayer.classList.add('hidden');

        // Fade in OS
        osLayer.classList.add('active');

        // Trigger OS Mode Switch
        if (window.os) {
          console.log('Transitioning to Lesson Mode...');
          window.os.switchMode('lesson');

          // Store user in OS state
          if (window.os.state) {
            window.os.state.user = user;
          }
        } else {
          console.warn('KellyOS not initialized yet - will initialize on ready');
        }

        // Cleanup Login Layer from DOM after fade
        setTimeout(() => {
          loginLayer.style.display = 'none';
        }, 800);
      }

      // ============================================
      // HANDLE LOGIN (Called by buttons)
      // ============================================

      // Make handleLogin global so onclick can find it
      window.handleLogin = async function handleLogin(btn, provider) {
        if (isProcessing) return;
        isProcessing = true;

        btn.classList.add('loading');

        try {
          if (provider === 'google') {
            // Real Google OAuth
            const { data, error } = await supabase.auth.signInWithOAuth({
              provider: 'google',
              options: {
                redirectTo: window.location.origin + '/',
                queryParams: {
                  access_type: 'offline',
                  prompt: 'consent',
                },
              },
            });

            if (error) {
              console.error('Google OAuth error:', error);
              showError(btn, error.message);
            }
            // If successful, browser will redirect to Google
          } else if (provider === 'apple') {
            // Real Apple OAuth
            const { data, error } = await supabase.auth.signInWithOAuth({
              provider: 'apple',
              options: {
                redirectTo: window.location.origin + '/',
              },
            });

            if (error) {
              console.error('Apple OAuth error:', error);
              showError(btn, error.message);
            }
          } else if (provider === 'guest') {
            // Guest mode - instant access, no auth required
            console.log('Entering guest mode...');

            // Store guest state
            localStorage.setItem('curious-kelly-guest', 'true');
            localStorage.setItem('curious-kelly-guest-started', new Date().toISOString());

            // Create a pseudo-user for guest mode
            const guestUser = {
              id: 'guest-' + Date.now(),
              email: null,
              isGuest: true,
              user_metadata: { full_name: 'Explorer' },
            };

            currentUser = guestUser;

            // Transition with slight delay for UX
            setTimeout(() => {
              transitionToOS(guestUser);
            }, 400);
          }
        } catch (err) {
          console.error('Login error:', err);
          showError(btn, 'Something went wrong. Please try again.');
        } finally {
          isProcessing = false;
          // Don't remove loading state for OAuth - browser will redirect
          if (provider === 'guest') {
            btn.classList.remove('loading');
          }
        }
      };

      // ============================================
      // ERROR DISPLAY
      // ============================================

      function showError(btn, message) {
        btn.classList.remove('loading');

        // Create error toast
        const toast = document.createElement('div');
        toast.className = 'error-toast';
        toast.textContent = message;
        toast.style.cssText = `
                position: fixed;
                bottom: 20px;
                left: 50%;
                transform: translateX(-50%);
                background: #ef4444;
                color: white;
                padding: 12px 24px;
                border-radius: 8px;
                font-size: 14px;
                z-index: 9999;
                animation: slideUp 0.3s ease;
            `;

        document.body.appendChild(toast);

        setTimeout(() => {
          toast.remove();
        }, 4000);
      }

      // ============================================
      // INITIALIZE ON LOAD
      // ============================================

      document.addEventListener('DOMContentLoaded', () => {
        // Check for existing session
        checkSession();

        // Add slide up animation
        const style = document.createElement('style');
        style.textContent = `
                @keyframes slideUp {
                    from { transform: translate(-50%, 20px); opacity: 0; }
                    to { transform: translate(-50%, 0); opacity: 1; }
                }
            `;
        document.head.appendChild(style);
      });

      // ============================================
      // EXPORT FOR OTHER SCRIPTS
      // ============================================

      window.CuriousKellyAuth = {
        supabase,
        getUser: () => currentUser,
        signOut: async () => {
          await supabase.auth.signOut();
          localStorage.removeItem('curious-kelly-guest');
          window.location.reload();
        },
        isGuest: () => currentUser?.isGuest || false,
        isAuthenticated: () => !!currentUser && !currentUser.isGuest,
      };

      // ============================================
      // MARKETING SECTION FUNCTIONS
      // ============================================

      // Load today's lesson
      async function loadTodaysLesson() {
        try {
          const dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);
          const { data, error } = await supabase
            .from('core_lessons')
            .select('day_number, topic')
            .eq('day_number', dayOfYear)
            .single();

          if (error) throw error;

          if (data) {
            document.getElementById('today-topic').textContent = data.topic;
            document.getElementById('today-thumbnail-text').textContent = data.topic;
            document.getElementById('today-day').textContent = data.day_number;
            document.getElementById('today-day-badge').textContent = `Day ${data.day_number}`;
          }
        } catch (error) {
          console.error('Error loading today\\'s lesson:', error);
        }
      }

      // Generate lesson thumbnail gradient
      function generateLessonThumbnail(topic) {
        const categories = {
          science: ['#1e3a8a', '#3b82f6'],
          history: ['#7c2d12', '#ea580c'],
          art: ['#701a75', '#c026d3'],
          math: ['#065f46', '#10b981'],
          nature: ['#14532d', '#22c55e'],
          tech: ['#1e40af', '#60a5fa'],
          culture: ['#7c2d12', '#f97316']
        };

        const lowerTopic = topic.toLowerCase();
        let gradient = categories.science;

        if (lowerTopic.includes('art') || lowerTopic.includes('music')) gradient = categories.art;
        else if (lowerTopic.includes('history') || lowerTopic.includes('war')) gradient = categories.history;
        else if (lowerTopic.includes('math') || lowerTopic.includes('number')) gradient = categories.math;
        else if (lowerTopic.includes('nature') || lowerTopic.includes('plant') || lowerTopic.includes('animal')) gradient = categories.nature;
        else if (lowerTopic.includes('tech') || lowerTopic.includes('computer')) gradient = categories.tech;
        else if (lowerTopic.includes('culture') || lowerTopic.includes('language')) gradient = categories.culture;

        return `linear-gradient(135deg, ${gradient[0]}, ${gradient[1]})`;
      }

      // Load curriculum
      async function loadCurriculum() {
        const grid = document.getElementById('month-grid');
        if (!grid) return;

        grid.innerHTML = `
          <div class="loading-skeleton">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
          </div>
        `;

        try {
          const { data: lessons, error } = await supabase
            .from('core_lessons')
            .select('day_number, topic')
            .order('day_number');

          if (error) throw error;
          if (!lessons) return;

          grid.innerHTML = '';

          const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
          const monthDays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];

          let dayIndex = 0;
          months.forEach((month, i) => {
            const monthLessons = lessons.slice(dayIndex, dayIndex + monthDays[i]);
            dayIndex += monthDays[i];

            const card = document.createElement('div');
            card.className = 'month-card';
            card.innerHTML = `
              <div class="month-header">
                <h3>${month}</h3>
                <span class="month-count">${monthLessons.length} lessons</span>
              </div>
              <div class="month-lessons">
                <div class="lesson-grid">
                  ${monthLessons.map(l => `
                    <div class="lesson-item" onclick="handleLogin(this, 'guest')">
                      <div class="lesson-item-day">Day ${l.day_number}</div>
                      <div class="lesson-item-title">${l.topic}</div>
                      <div class="lesson-item-thumbnail" style="background: ${generateLessonThumbnail(l.topic)}"></div>
                    </div>
                  `).join('')}
                </div>
              </div>
            `;
            grid.appendChild(card);

            card.querySelector('.month-header').addEventListener('click', function() {
              card.classList.toggle('open');
            });
          });
        } catch (error) {
          console.error('Error loading curriculum:', error);
          grid.innerHTML = '<p style="text-align: center; color: var(--text-muted);">Unable to load curriculum.</p>';
        }
      }

      // Perspective explorer
      window.setYear = function(year) {
        const slider = document.getElementById('year-slider');
        if (slider) {
          slider.value = year;
          updatePerspectives();
        }
      };

      async function updatePerspectives() {
        const slider = document.getElementById('year-slider');
        if (!slider) return;

        const year = parseInt(slider.value);
        const age = 2025 - year;
        const dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);

        const yearEl = document.getElementById('perspective-year');
        const ageEl = document.getElementById('perspective-age');
        if (yearEl) yearEl.textContent = year;
        if (ageEl) ageEl.textContent = age;

        const cards = [
          { year: year - 30, label: "30 years older" },
          { year: year, label: "Your perspective", current: true },
          { year: Math.min(year + 20, 2020), label: "20 years younger" }
        ];

        const container = document.getElementById('perspective-cards');
        if (!container) return;

        const hooks = await Promise.all(cards.map(async c => {
          const cardAge = 2025 - c.year;
          return await getHookForAge(cardAge, dayOfYear);
        }));

        container.innerHTML = cards.map((c, i) => {
          const cardAge = 2025 - c.year;
          const hook = hooks[i];
          return `
            <div class="perspective-card ${c.current ? 'current' : ''}">
              <h4>${c.year}</h4>
              <div class="perspective-age">${cardAge} years old today ${c.current ? '(You)' : ''}</div>
              <div class="perspective-hook">"${hook.text}"</div>
              <div class="perspective-context">${hook.context}</div>
            </div>
          `;
        }).join('');
      }

      async function getHookForAge(age, dayNumber = 1) {
        let ageBucket;
        if (age <= 5) ageBucket = '2-5';
        else if (age <= 12) ageBucket = '6-12';
        else if (age <= 17) ageBucket = '13-17';
        else if (age <= 29) ageBucket = '18-29';
        else if (age <= 54) ageBucket = '30-54';
        else ageBucket = '55+';

        try {
          const { data, error } = await supabase
            .from('lesson_age_hooks')
            .select('hook')
            .eq('day_number', dayNumber)
            .eq('age_bucket', ageBucket)
            .single();

          if (data && !error) {
            return {
              text: data.hook,
              context: `Personalized for ages ${ageBucket}`
            };
          }
        } catch (error) {
          console.error('Error loading hook:', error);
        }

        // Fallback hooks
        if (age >= 70) return { text: "Wisdom comes from experience.", context: "You've seen it all." };
        if (age >= 55) return { text: "You've watched the world transform.", context: "Experience gives context." };
        if (age >= 40) return { text: "Old enough to remember, young enough to adapt.", context: "You bridge generations." };
        if (age >= 25) return { text: "You're building your life.", context: "Peak learning years." };
        if (age >= 15) return { text: "School teaches facts. We'll teach why they matter.", context: "You're figuring things out." };
        return { text: "You're just starting your learning journey.", context: "Everything is new!" };
      }

      // Earnings calculator
      function updateCalculator() {
        const slider = document.getElementById('referrals-slider');
        if (!slider) return;

        const referrals = parseInt(slider.value);
        let commission, tierName;

        if (referrals < 100) {
          commission = 0.20;
          tierName = 'Scholar (20%)';
        } else if (referrals < 500) {
          commission = 0.25;
          tierName = 'Fellow (25%)';
        } else {
          commission = 0.30;
          tierName = 'Ambassador (30%)';
        }

        const annualPerSub = 199 * commission;
        const monthlyPerSub = annualPerSub / 12;
        const monthly = Math.round(referrals * monthlyPerSub);
        const annual = Math.round(referrals * annualPerSub);

        const valueEl = document.getElementById('referrals-value');
        const tierEl = document.getElementById('calc-tier');
        const monthlyEl = document.getElementById('calc-monthly');
        const annualEl = document.getElementById('calc-annual');

        if (valueEl) valueEl.textContent = referrals;
        if (tierEl) tierEl.textContent = tierName;
        if (monthlyEl) monthlyEl.textContent = '$' + monthly.toLocaleString();
        if (annualEl) annualEl.textContent = '$' + annual.toLocaleString();
      }

      // Collapsible sections
      window.toggleCollapsible = function(header) {
        header.parentElement.classList.toggle('open');
      };

      // Age selector
      window.selectAge = function(btn, age) {
        document.querySelectorAll('.age-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      };

      // Checkout
      window.handleCheckout = function(plan) {
        sessionStorage.setItem('selectedPlan', plan);
        window.location.href = '/pricing.html';
      };

      // Gift
      window.handleGift = function(duration) {
        sessionStorage.setItem('giftDuration', duration);
        window.location.href = '/gifts.html?duration=' + duration;
      };

      // Initialize marketing sections
      document.addEventListener('DOMContentLoaded', () => {
        // Only load if we're in login layer (not in OS)
        if (document.getElementById('login-layer') && !document.getElementById('login-layer').classList.contains('hidden')) {
          loadTodaysLesson();
          loadCurriculum();
          updatePerspectives();
          updateCalculator();

          // Add event listeners
          const yearSlider = document.getElementById('year-slider');
          if (yearSlider) {
            yearSlider.addEventListener('input', updatePerspectives);
          }

          const referralsSlider = document.getElementById('referrals-slider');
          if (referralsSlider) {
            referralsSlider.addEventListener('input', updateCalculator);
          }
        }
      });
    </script>
  </body>
</html>
