---
import '../styles/unified-design-system.scss';
// Production fix: Google SVG inline to avoid COEP blocking
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta
      name="description"
      content="Curious Kelly - The operating system for your potential. Your personal AI teacher for a whole year."
    />
    <title>Curious Kelly</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Times+New+Roman&display=swap"
      rel="stylesheet"
    />

    <!-- OS Styles (Preloaded) -->
    <link rel="stylesheet" href="/lesson-player/css/styles.css" />
    <link rel="stylesheet" href="/lesson-player/css/ui-kit.css" />

    <!-- Supabase (Global for OS) -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
      /* 
         * UNIFIED ARCHITECTURE:
         * 1. Login Layer (Z-Index 1000) - The "Marketing" State
         * 2. OS Layer (Z-Index 0) - The "App" State (Preloaded)
         */

      :root {
        --bg-color: #0a0a0b;
        --bg-secondary: #111113;
        --bg-elevated: #18181b;
        --text-primary: #fafafa;
        --text-secondary: #a1a1aa;
        --text-muted: #71717a;
        --accent-primary: #3b82f6;
        --accent-hover: #2563eb;
        --accent-glow: rgba(59, 130, 246, 0.15);
        --input-bg: #18181b;
        --border-color: #27272a;
        --border-hover: #3f3f46;
        --success: #22c55e;
        --error: #ef4444;
        --max-width: 1200px;
        --header-height: 72px;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background-color: var(--bg-color);
        color: var(--text-primary);
        min-height: 100vh;
        line-height: 1.6;
        overflow-x: hidden;
      }

      html {
        scroll-behavior: smooth;
      }

      /* --- LOGIN LAYER STYLES --- */
      #login-layer {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1000;
        background-color: var(--bg-color);
        overflow-y: auto;
        overflow-x: hidden;
        transition:
          opacity 0.8s ease-in-out,
          transform 0.8s ease-in-out;
      }

      #login-layer.hidden {
        opacity: 0;
        pointer-events: none;
        transform: scale(1.05);
      }

      .container {
        display: flex;
        width: 100%;
        min-height: 100vh;
      }

      .left-panel {
        flex: 1;
        padding: 80px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-width: 640px;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        z-index: 2;
      }

      .right-panel {
        flex: 1;
        background-color: var(--bg-color);
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
      }

      .right-panel::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, #202023 0%, #0f0f11 70%);
        z-index: 1;
      }

      .logo {
        font-weight: 600;
        font-size: 1.2rem;
        margin-bottom: auto;
        display: flex;
        align-items: center;
        gap: 10px;
      }

      h1 {
        font-family: 'Times New Roman', serif;
        font-size: 5rem;
        font-weight: 400;
        line-height: 1;
        margin-bottom: 24px;
        letter-spacing: -2px;
        background: linear-gradient(to bottom right, #fff, #ccc);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .subtitle {
        font-size: 1.2rem;
        color: var(--text-secondary);
        margin-bottom: 48px;
        font-weight: 300;
      }

      .login-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        width: 100%;
        max-width: 400px;
      }

      .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 14px 20px;
        border-radius: 12px;
        text-decoration: none;
        font-size: 1rem;
        transition: all 0.2s ease;
        cursor: pointer;
        border: 1px solid var(--border-color);
      }

      .btn:hover {
        transform: translateY(-1px);
      }
      .btn:active {
        transform: scale(0.98);
      }

      .btn-primary {
        background-color: #f4f4f5;
        color: #18181b;
        border: none;
        font-weight: 600;
      }

      .btn-outline {
        background-color: transparent;
        color: var(--text-primary);
      }

      .divider {
        display: flex;
        align-items: center;
        color: var(--text-secondary);
        font-size: 0.8rem;
        margin: 10px 0;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .divider::before,
      .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid var(--border-color);
      }
      .divider span {
        padding: 0 10px;
      }

      .hero-image {
        max-width: 85%;
        max-height: 85%;
        object-fit: contain;
        z-index: 2;
        animation: float 8s ease-in-out infinite;
        filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.5));
      }

      @keyframes float {
        0% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-30px);
        }
        100% {
          transform: translateY(0px);
        }
      }

      .scribble {
        position: absolute;
        pointer-events: none;
        opacity: 0.4;
        z-index: 3;
      }

      /* Spinner */
      .spinner {
        border: 2px solid rgba(255, 255, 255, 0.1);
        border-left-color: #fff;
        border-radius: 50%;
        width: 16px;
        height: 16px;
        animation: spin 1s linear infinite;
        display: none;
      }
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }
      .btn.loading .spinner {
        display: block;
      }
      .btn.loading span,
      .btn.loading img {
        display: none;
      }

      /* --- OS LAYER TWEAKS --- */
      /* Ensure Unity sits behind but accessible */
      #app-layer-desktop {
        position: absolute;
        inset: 0;
        z-index: 1;
        opacity: 0; /* Hidden initially */
        transition: opacity 1s ease-in-out;
      }

      #app-layer-desktop.active {
        opacity: 1;
        pointer-events: auto;
      }

      /* Mobile Response for Login */
      @media (max-width: 900px) {
        .container {
          flex-direction: column;
        }
        .right-panel {
          height: 30vh;
          order: -1;
        }
        .left-panel {
          padding: 40px;
          border-right: none;
        }
        h1 {
          font-size: 3.5rem;
        }
      }

      /* ========================================
         UNIFIED MARKETING SECTIONS
         ======================================== */
      
      /* Fonts for marketing */
      @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Inter:wght@400;500;600;700&display=swap');

      /* Header */
      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--header-height);
        background: rgba(10, 10, 11, 0.95);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-color);
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 48px;
      }

      .logo-header {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        text-decoration: none;
        color: var(--text-primary);
        letter-spacing: -0.02em;
      }

      .logo-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: color 0.2s;
      }

      .nav-link:hover {
        color: var(--text-primary);
      }

      /* Sections */
      section {
        padding: 100px 48px;
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .section-header {
        text-align: center;
        margin-bottom: 60px;
      }

      .section-label {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.3);
        border-radius: 100px;
        font-size: 0.85rem;
        color: var(--accent-primary);
        margin-bottom: 16px;
        font-weight: 600;
      }

      h2 {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 3rem;
        font-weight: 400;
        letter-spacing: -0.03em;
        margin-bottom: 16px;
      }

      .section-header p {
        font-size: 1.15rem;
        color: var(--text-secondary);
        max-width: 600px;
        margin: 0 auto;
      }

      /* TODAY'S LESSON */
      .today-lesson {
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
      }

      .lesson-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
        cursor: pointer;
        transition: transform 0.2s, border-color 0.2s;
      }

      .lesson-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-primary);
      }

      .lesson-thumbnail {
        width: 100%;
        aspect-ratio: 16/9;
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }

      .lesson-thumbnail-text {
        font-family: 'Fraunces', serif;
        font-size: 2rem;
        font-weight: 500;
        color: white;
        text-align: center;
        padding: 20px;
        z-index: 2;
      }

      .lesson-day-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(10px);
        padding: 8px 16px;
        border-radius: 100px;
        font-size: 0.85rem;
        font-weight: 600;
        z-index: 3;
      }

      .lesson-info h3 {
        font-family: 'Fraunces', serif;
        font-size: 2rem;
        margin-bottom: 16px;
      }

      .lesson-hook {
        font-size: 1.15rem;
        color: var(--text-secondary);
        margin-bottom: 24px;
        font-style: italic;
      }

      .lesson-meta {
        display: flex;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
      }

      .meta-item {
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      /* CURRICULUM */
      .curriculum {
        background: var(--bg-color);
      }

      .age-selector {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 40px;
        flex-wrap: wrap;
      }

      .age-btn {
        padding: 12px 24px;
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--text-secondary);
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
      }

      .age-btn:hover {
        border-color: var(--accent-primary);
        color: var(--text-primary);
      }

      .age-btn.active {
        background: var(--accent-hover);
        border-color: var(--accent-hover);
        color: white;
      }

      .month-grid {
        display: grid;
        gap: 24px;
      }

      .loading-skeleton {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
      }

      .skeleton-card {
        height: 200px;
        background: linear-gradient(90deg, #18181b 0%, #27272a 50%, #18181b 100%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 16px;
      }

      @keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      .month-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s;
      }

      .month-header {
        padding: 24px;
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
        transition: background 0.2s;
      }

      .month-header:hover {
        background: var(--bg-elevated);
      }

      .month-header h3 {
        font-family: 'Fraunces', serif;
        font-size: 1.5rem;
        font-weight: 500;
      }

      .month-count {
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .month-lessons {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .month-card.open .month-lessons {
        max-height: 2000px;
      }

      .lesson-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 16px;
        padding: 24px;
      }

      .lesson-item {
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.2s;
      }

      .lesson-item:hover {
        border-color: var(--accent-primary);
        transform: translateY(-2px);
      }

      .lesson-item-day {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 8px;
      }

      .lesson-item-title {
        font-size: 1rem;
        font-weight: 500;
        margin-bottom: 8px;
      }

      .lesson-item-thumbnail {
        width: 100%;
        aspect-ratio: 16/9;
        background: linear-gradient(135deg, #1e3a8a, #3b82f6);
        border-radius: 8px;
        margin-top: 12px;
      }

      /* PERSPECTIVES */
      .perspectives {
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
      }

      .time-machine {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 40px;
      }

      .year-display {
        text-align: center;
        margin-bottom: 32px;
      }

      .year-big {
        font-family: 'Fraunces', serif;
        font-size: 5rem;
        font-weight: 300;
        background: linear-gradient(135deg, var(--accent-primary), #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        line-height: 1;
      }

      .year-context {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-top: 8px;
      }

      .year-context span {
        color: var(--accent-primary);
        font-weight: 600;
      }

      .year-slider {
        width: 100%;
        height: 8px;
        background: var(--bg-color);
        border-radius: 4px;
        outline: none;
        -webkit-appearance: none;
        margin: 20px 0;
      }

      .year-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 28px;
        height: 28px;
        background: var(--accent-hover);
        border-radius: 50%;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
      }

      .year-slider::-moz-range-thumb {
        width: 28px;
        height: 28px;
        background: var(--accent-hover);
        border-radius: 50%;
        cursor: pointer;
        border: none;
      }

      .slider-labels {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 12px;
      }

      .generation-picks {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 24px;
      }

      .gen-btn {
        padding: 10px 20px;
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        color: var(--text-secondary);
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
      }

      .gen-btn:hover {
        border-color: var(--accent-primary);
        color: var(--text-primary);
      }

      .perspective-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 24px;
      }

      .perspective-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 28px;
        transition: all 0.3s;
      }

      .perspective-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-primary);
      }

      .perspective-card.current {
        border-color: var(--accent-hover);
        background: linear-gradient(180deg, rgba(37, 99, 235, 0.1) 0%, var(--bg-elevated) 100%);
      }

      .perspective-card h4 {
        font-family: 'Fraunces', serif;
        font-size: 1.75rem;
        margin-bottom: 8px;
      }

      .perspective-age {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 20px;
      }

      .perspective-hook {
        font-size: 1.15rem;
        line-height: 1.6;
        margin-bottom: 16px;
        padding: 16px;
        background: var(--bg-color);
        border-radius: 12px;
        border-left: 3px solid var(--accent-primary);
        font-style: italic;
      }

      .perspective-context {
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.6;
      }

      /* PRICING */
      .pricing {
        background: var(--bg-color);
      }

      .pricing-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 60px;
      }

      .price-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px;
        position: relative;
        transition: all 0.3s;
      }

      .price-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-primary);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      .price-card.featured {
        border-color: var(--accent-hover);
        background: linear-gradient(180deg, rgba(37, 99, 235, 0.1) 0%, var(--bg-elevated) 100%);
      }

      .price-card.featured::before {
        content: '';
        position: absolute;
        top: -1px;
        left: -1px;
        right: -1px;
        height: 4px;
        background: linear-gradient(90deg, var(--accent-primary), #8b5cf6);
        border-radius: 20px 20px 0 0;
      }

      .price-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        padding: 6px 16px;
        background: linear-gradient(135deg, var(--accent-hover), #8b5cf6);
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 100px;
      }

      .price-name {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .price-amount {
        font-family: 'Fraunces', serif;
        font-size: 3.5rem;
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1;
        margin-bottom: 8px;
      }

      .price-amount span {
        font-size: 1rem;
        color: var(--text-muted);
        margin-left: 4px;
      }

      .price-desc {
        color: var(--text-secondary);
        margin-bottom: 24px;
      }

      .price-features {
        list-style: none;
        margin-bottom: 32px;
      }

      .price-features li {
        padding: 10px 0;
        color: var(--text-secondary);
        font-size: 0.95rem;
        display: flex;
        gap: 12px;
      }

      .price-features li::before {
        content: "✓";
        color: var(--success);
        font-weight: 700;
        flex-shrink: 0;
      }

      /* GIFTS */
      .gifts {
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
      }

      .collapsible-header {
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 0;
        border-bottom: 1px solid var(--border-color);
        user-select: none;
        transition: background 0.2s;
      }

      .collapsible-header:hover {
        background: rgba(255,255,255,0.02);
      }

      .collapsible-header h3 {
        font-family: 'Fraunces', serif;
        font-size: 1.5rem;
        font-weight: 500;
      }

      .collapse-icon {
        font-size: 1.5rem;
        transition: transform 0.3s;
      }

      .collapsible.open .collapse-icon {
        transform: rotate(180deg);
      }

      .collapsible-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
      }

      .collapsible.open .collapsible-content {
        max-height: 2000px;
      }

      .gift-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        padding: 40px 0;
      }

      .gift-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 28px 24px;
        text-align: center;
        transition: all 0.2s;
        cursor: pointer;
      }

      .gift-card:hover {
        border-color: var(--accent-primary);
        transform: translateY(-2px);
      }

      .gift-icon {
        font-size: 2.5rem;
        margin-bottom: 16px;
      }

      .gift-card h4 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .gift-price {
        font-family: 'Fraunces', serif;
        font-size: 1.75rem;
        font-weight: 500;
        margin-bottom: 4px;
      }

      .gift-value {
        color: var(--text-muted);
        font-size: 0.8rem;
      }

      /* CAREERS */
      .careers {
        background: var(--bg-color);
      }

      .earnings-calculator {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 40px;
      }

      .earnings-calculator h3 {
        font-family: 'Fraunces', serif;
        font-size: 1.5rem;
        margin-bottom: 24px;
        text-align: center;
      }

      .calc-slider-group {
        margin-bottom: 32px;
      }

      .calc-slider-group label {
        display: block;
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 12px;
      }

      .calc-slider-group input[type="range"] {
        width: 100%;
        height: 8px;
        background: var(--bg-color);
        border-radius: 4px;
        outline: none;
        -webkit-appearance: none;
      }

      .calc-slider-group input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 24px;
        height: 24px;
        background: var(--accent-hover);
        border-radius: 50%;
        cursor: pointer;
      }

      .calc-value {
        text-align: center;
        font-size: 1.5rem;
        font-weight: 600;
        margin-top: 12px;
      }

      .calc-results {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-top: 24px;
        border-top: 1px solid var(--border-color);
      }

      .calc-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 1rem;
      }

      .calc-row span {
        color: var(--text-secondary);
      }

      .calc-row strong {
        font-size: 1.25rem;
        color: var(--success);
      }

      .tier-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
      }

      .tier-card {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 32px;
        position: relative;
        transition: all 0.3s;
      }

      .tier-card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-primary);
      }

      .tier-card.featured {
        border-color: var(--accent-hover);
        background: linear-gradient(180deg, rgba(37, 99, 235, 0.1) 0%, var(--bg-elevated) 100%);
      }

      .tier-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--accent-hover);
        color: white;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
      }

      .tier-card h4 {
        font-size: 1.25rem;
        margin-bottom: 12px;
      }

      .tier-rate {
        font-family: 'Fraunces', serif;
        font-size: 2.5rem;
        font-weight: 300;
        color: var(--accent-primary);
        margin-bottom: 8px;
      }

      .tier-card p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-bottom: 20px;
      }

      .tier-card ul {
        list-style: none;
      }

      .tier-card ul li {
        padding: 8px 0;
        color: var(--text-secondary);
        font-size: 0.9rem;
        display: flex;
        gap: 8px;
      }

      .tier-card ul li::before {
        content: "✓";
        color: var(--success);
        font-weight: 700;
      }

      .cta-box {
        background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(37, 99, 235, 0.05));
        border: 1px solid var(--accent-hover);
        border-radius: 20px;
        padding: 48px;
        text-align: center;
      }

      .cta-box h3 {
        font-family: 'Fraunces', serif;
        font-size: 2rem;
        margin-bottom: 12px;
      }

      .cta-box p {
        color: var(--text-secondary);
        margin-bottom: 24px;
      }

      /* ENTERPRISE */
      .enterprise {
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
      }

      .enterprise-content {
        padding: 40px 0;
      }

      .enterprise-features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
      }

      .enterprise-feature {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
      }

      .enterprise-feature h4 {
        font-size: 1.1rem;
        margin-bottom: 8px;
      }

      .enterprise-feature p {
        color: var(--text-secondary);
        font-size: 0.9rem;
      }

      /* ABOUT */
      .about {
        background: var(--bg-color);
      }

      .about-content {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
      }

      .about-content p {
        font-size: 1.15rem;
        color: var(--text-secondary);
        line-height: 1.8;
        margin-bottom: 24px;
      }

      .kelly-avatar-large {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        margin: 0 auto 32px;
        border: 4px solid var(--accent-hover);
      }

      .mission-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 32px;
        margin-top: 60px;
      }

      .mission-item {
        text-align: center;
      }

      .mission-icon {
        font-size: 3rem;
        margin-bottom: 16px;
      }

      .mission-item h4 {
        font-size: 1.25rem;
        margin-bottom: 12px;
      }

      .mission-item p {
        color: var(--text-secondary);
        font-size: 0.95rem;
      }

      /* NEWSROOM */
      .newsroom {
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
      }

      .newsroom-content {
        padding: 40px 0;
      }

      .press-releases {
        display: grid;
        gap: 20px;
        margin-bottom: 40px;
      }

      .press-item {
        background: var(--bg-elevated);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .press-item h4 {
        font-size: 1.1rem;
        margin-bottom: 4px;
      }

      .press-date {
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      .press-link {
        color: var(--accent-primary);
        text-decoration: none;
        font-weight: 600;
      }

      .press-link:hover {
        text-decoration: underline;
      }

      /* FOOTER */
      .site-footer {
        background: #000;
        padding: 80px 48px 32px;
        border-top: 1px solid var(--border-color);
      }

      .footer-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 48px;
        max-width: var(--max-width);
        margin: 0 auto 60px;
      }

      .footer-col h4 {
        color: var(--text-primary);
        font-size: 0.85rem;
        margin-bottom: 20px;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      .footer-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .footer-links a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.2s;
      }

      .footer-links a:hover {
        color: var(--text-primary);
      }

      .app-badges {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .app-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 10px 14px;
        color: var(--text-primary);
        text-decoration: none;
        width: 160px;
        transition: all 0.2s;
      }

      .app-badge:hover {
        border-color: var(--text-secondary);
        background: var(--bg-secondary);
      }

      .app-badge svg {
        height: 20px;
        width: auto;
        margin-right: 10px;
        fill: currentColor;
      }

      .app-badge span {
        font-size: 0.7rem;
        text-align: left;
        line-height: 1.2;
        color: var(--text-secondary);
      }

      .app-badge b {
        display: block;
        font-size: 0.85rem;
        color: var(--text-primary);
      }

      .footer-bottom {
        border-top: 1px solid var(--border-color);
        padding-top: 24px;
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: var(--text-muted);
        max-width: var(--max-width);
        margin: 0 auto;
      }

      /* RESPONSIVE */
      @media (max-width: 1024px) {
        header {
          padding: 0 24px;
        }

        .nav-links {
          display: none;
        }

        section {
          padding: 60px 24px;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
          gap: 32px;
        }

        .lesson-card {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 768px) {
        h1 {
          font-size: 3rem;
        }

        h2 {
          font-size: 2rem;
        }

        .year-big {
          font-size: 3.5rem;
        }

        .footer-bottom {
          flex-direction: column;
          gap: 8px;
          text-align: center;
        }
      }

      .hidden {
        display: none;
      }
    </style>
  </head>
  <body>
    <!-- ==================================================================
         LAYER 1: LOGIN / LANDING (The "Site")
         ================================================================== -->
    <div id="login-layer">
      <div class="container">
        <div class="left-panel">
          <div class="logo">
            <span style="color: var(--accent-orange); font-size: 1.5rem;">✨</span> Curious Kelly
          </div>

          <div class="main-content" style="margin-top: auto; margin-bottom: auto;">
            <h1>Curious?<br />Always.</h1>
            <p class="subtitle">The operating system for your potential.</p>

            <div class="login-container">
              <!-- Primary: Google (most users) -->
              <button class="btn btn-outline" onclick="handleLogin(this, 'google')" id="btn-google">
                <img
                  src="data:image/svg+xml;base64,"
                  width="20"
                  alt="G"
                />
                <span>Continue with Google</span>
                <div class="spinner"></div>
              </button>

              <!-- Apple Sign In (for iOS users) -->
              <button
                class="btn btn-outline"
                onclick="handleLogin(this, 'apple')"
                id="btn-apple"
                style="background: #000; border-color: #333;"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                  <path
                    d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
                  ></path>
                </svg>
                <span>Continue with Apple</span>
                <div class="spinner"></div>
              </button>

              <div class="divider"><span>OR</span></div>

              <!-- Guest mode - instant, no friction -->
              <button class="btn btn-primary" onclick="handleLogin(this, 'guest')" id="btn-guest">
                <span>✨ Start Learning Now</span>
                <div class="spinner"></div>
              </button>
              <p
                style="text-align: center; font-size: 0.75rem; color: var(--text-secondary); margin-top: 8px;"
              >
                No account needed. Upgrade anytime.
              </p>

              <p
                style="margin-top: 24px; font-size: 0.7rem; color: var(--text-secondary); text-align: center;"
              >
                By continuing, you agree to our <a
                  href="/privacy.html"
                  style="color:inherit; text-decoration: underline;">Privacy Policy</a
                >
                and <a href="/terms.html" style="color:inherit; text-decoration: underline;"
                  >Terms of Service</a
                >.
              </p>
            </div>
          </div>
        </div>

        <div class="right-panel">
          <picture>
            <source
              type="image/webp"
              srcset="
                /assets/kelly/production/hero/kelly-hero-mobile.webp 640w,
                /assets/kelly/production/hero/kelly-hero-tablet.webp 1280w,
                /assets/kelly/production/hero/kelly-hero-desktop.webp 1920w,
                /assets/kelly/production/hero/kelly-hero-4k.webp 3840w
              "
              sizes="(max-width: 900px) 100vw, 50vw"
            />
            <source
              type="image/jpeg"
              srcset="
                /assets/kelly/production/hero/kelly-hero-mobile.jpg 640w,
                /assets/kelly/production/hero/kelly-hero-tablet.jpg 1280w,
                /assets/kelly/production/hero/kelly-hero-desktop.jpg 1920w,
                /assets/kelly/production/hero/kelly-hero-4k.jpg 3840w
              "
              sizes="(max-width: 900px) 100vw, 50vw"
            />
            <img
              src="/assets/kelly/production/hero/kelly-hero-desktop.jpg"
              alt="Kelly - Your AI learning companion"
              class="hero-image"
              loading="eager"
              fetchpriority="high"
              width="1920"
              height="1080"
            />
          </picture>

          <!-- Claude-like Scribbles -->
          <svg
            class="scribble"
            style="top: 20%; left: 10%; width: 100px; height: 100px;"
            viewBox="0 0 100 100"
          >
            <path d="M10,50 Q30,10 50,50 T90,50" fill="none" stroke="#84cc16" stroke-width="3"
            ></path>
          </svg>
          <svg
            class="scribble"
            style="bottom: 30%; right: 20%; width: 60px; height: 60px;"
            viewBox="0 0 100 100"
          >
            <circle
              cx="50"
              cy="50"
              r="40"
              fill="none"
              stroke="#f472b6"
              stroke-width="2"
              stroke-dasharray="10,5"></circle>
          </svg>
          <svg
            class="scribble"
            style="top: 50%; right: 10%; width: 40px; height: 40px;"
            viewBox="0 0 100 100"
          >
            <text x="10" y="60" fill="#60a5fa" font-family="monospace" font-size="40"
              >&lt;/&gt;</text
            >
          </svg>
        </div>
      </div>

      <!-- ==================================================================
           UNIFIED MARKETING SECTIONS (Scrollable below auth)
           ================================================================== -->
      
      <!-- TODAY'S LESSON -->
      <section class="today-lesson">
        <div class="section-header">
          <span class="section-label">Today's Topic</span>
          <h2 id="today-topic">How Money Works</h2>
          <p id="today-hook">"Every dollar tells a story"</p>
        </div>

        <div class="lesson-card">
          <div class="lesson-thumbnail">
            <span class="lesson-day-badge" id="today-day-badge">Day 334</span>
            <div class="lesson-thumbnail-text" id="today-thumbnail-text">How Money Works</div>
          </div>
          <div class="lesson-info">
            <div class="lesson-meta">
              <span class="meta-item">📅 Day <span id="today-day">334</span> of 366</span>
              <span class="meta-item">⏱️ 5 minutes</span>
              <span class="meta-item">👥 <span id="today-learners">1.2M</span> learned today</span>
            </div>
            <button class="btn btn-primary" onclick="handleLogin(this, 'guest')">
              Join Live Class
            </button>
            <button class="btn btn-outline" onclick="handleLogin(this, 'guest')">
              Watch On Demand
            </button>
          </div>
        </div>
      </section>

      <!-- CURRICULUM -->
      <section class="curriculum" id="curriculum">
        <div class="section-header">
          <span class="section-label">365 Days of Wonder</span>
          <h2>The Complete Curriculum</h2>
          <p>One topic per day, personalized for your age. From "How Leaves Feed the World" to "What Leaders Actually Do."</p>
        </div>

        <div class="age-selector">
          <button class="age-btn active" onclick="selectAge(this, '2-5')">Ages 2-5</button>
          <button class="age-btn" onclick="selectAge(this, '6-12')">Ages 6-12</button>
          <button class="age-btn" onclick="selectAge(this, '13-17')">Ages 13-17</button>
          <button class="age-btn" onclick="selectAge(this, '18-29')">Ages 18-29</button>
          <button class="age-btn" onclick="selectAge(this, '30-54')">Ages 30-54</button>
          <button class="age-btn" onclick="selectAge(this, '55+')">Ages 55+</button>
        </div>

        <div class="month-grid" id="month-grid">
          <!-- Populated by JavaScript -->
        </div>
      </section>

      <!-- PERSPECTIVES -->
      <section class="perspectives" id="perspectives">
        <div class="section-header">
          <span class="section-label">Perspective Explorer</span>
          <h2>The Same Topic, Through Different Eyes</h2>
          <p>See how Kelly adapts the same lesson based on your generation. Drag the slider to explore.</p>
        </div>

        <div class="time-machine">
          <div class="year-display">
            <div class="year-big" id="perspective-year">1990</div>
            <div class="year-context">You'd be <span id="perspective-age">35</span> years old today</div>
          </div>

          <input type="range" min="1945" max="2020" value="1990" id="year-slider" class="year-slider">
          <div class="slider-labels">
            <span>1945</span>
            <span>1980</span>
            <span>2020</span>
          </div>

          <div class="generation-picks">
            <button class="gen-btn" onclick="setYear(1955)">Silent Gen</button>
            <button class="gen-btn" onclick="setYear(1960)">Boomer</button>
            <button class="gen-btn" onclick="setYear(1975)">Gen X</button>
            <button class="gen-btn" onclick="setYear(1990)">Millennial</button>
            <button class="gen-btn" onclick="setYear(2002)">Gen Z</button>
            <button class="gen-btn" onclick="setYear(2015)">Gen Alpha</button>
          </div>
        </div>

        <div class="perspective-cards" id="perspective-cards">
          <!-- Populated by JavaScript -->
        </div>
      </section>

      <!-- PRICING -->
      <section class="pricing" id="pricing">
        <div class="section-header">
          <span class="section-label">Simple, Transparent Pricing</span>
          <h2>Start Free. Upgrade When Ready.</h2>
          <p>One subscription unlocks daily lessons for your whole family. All ages, all topics, all languages.</p>
        </div>

        <div class="pricing-grid">
          <!-- Free -->
          <div class="price-card">
            <div class="price-name">Free</div>
            <div class="price-amount">$0</div>
            <div class="price-desc">Today's lesson, forever free</div>
            <ul class="price-features">
              <li>Today's daily lesson</li>
              <li>Basic personalization</li>
              <li>Community access</li>
            </ul>
            <button class="btn btn-outline" onclick="handleLogin(this, 'guest')">Start Learning</button>
          </div>

          <!-- Monthly -->
          <div class="price-card">
            <div class="price-name">Monthly</div>
            <div class="price-amount">$9.99<span>/mo</span></div>
            <div class="price-desc">All 366 lessons, anytime</div>
            <ul class="price-features">
              <li>Access every lesson</li>
              <li>Learn at your pace</li>
              <li>Full personalization</li>
              <li>Progress tracking</li>
              <li>Cancel anytime</li>
            </ul>
            <button class="btn btn-primary" onclick="handleCheckout('monthly')">Subscribe</button>
          </div>

          <!-- Annual (Featured) -->
          <div class="price-card featured">
            <div class="price-badge">Best Value</div>
            <div class="price-name">Annual</div>
            <div class="price-amount">$99<span>/year</span></div>
            <div class="price-desc">Save $20 (17% off)</div>
            <ul class="price-features">
              <li>Everything in Monthly</li>
              <li>2 months free</li>
              <li>Priority support</li>
              <li>Early feature access</li>
            </ul>
            <button class="btn btn-primary" onclick="handleCheckout('annual')">Subscribe</button>
          </div>

          <!-- Lifetime -->
          <div class="price-card">
            <div class="price-name">Lifetime</div>
            <div class="price-amount">$299<span>one-time</span></div>
            <div class="price-desc">Forever access</div>
            <ul class="price-features">
              <li>All features, forever</li>
              <li>All future content</li>
              <li>Founding member badge</li>
              <li>VIP support</li>
            </ul>
            <button class="btn btn-outline" onclick="handleCheckout('lifetime')">Get Lifetime</button>
          </div>
        </div>
      </section>

      <!-- GIFTS (Collapsible) -->
      <section class="gifts collapsible" id="gifts">
        <div class="collapsible-header" onclick="toggleCollapsible(this)">
          <h3>🎁 Give the Gift of Learning</h3>
          <span class="collapse-icon">▼</span>
        </div>
        <div class="collapsible-content">
          <p style="text-align: center; color: var(--text-secondary); margin: 24px 0;">Share the joy of daily discovery with someone you love.</p>
          <div class="gift-grid">
            <div class="gift-card" onclick="handleGift('3-month')">
              <div class="gift-icon">🌱</div>
              <h4>3 Months</h4>
              <div class="gift-price">$34.99</div>
              <div class="gift-value">90 daily lessons</div>
            </div>
            <div class="gift-card" onclick="handleGift('6-month')">
              <div class="gift-icon">🌿</div>
              <h4>6 Months</h4>
              <div class="gift-price">$59.99</div>
              <div class="gift-value">180 daily lessons</div>
            </div>
            <div class="gift-card" onclick="handleGift('12-month')">
              <div class="gift-icon">🌳</div>
              <h4>12 Months</h4>
              <div class="gift-price">$99.99</div>
              <div class="gift-value">365 daily lessons</div>
            </div>
            <div class="gift-card" onclick="handleGift('lifetime')">
              <div class="gift-icon">💎</div>
              <h4>Lifetime</h4>
              <div class="gift-price">$299.99</div>
              <div class="gift-value">Unlimited learning</div>
            </div>
          </div>
