---
/**
 * Hero Section with Kelly Image and Lead Form
 * Displays age-appropriate Kelly based on audience
 */

interface Props {
  dictionary: any;
  locale: string;
  nonce: string;
  audienceType?: 'child' | 'teen' | 'adult' | 'senior';
}

const { dictionary, locale, nonce, audienceType = 'adult' } = Astro.props;

// Kelly image paths based on age
const kellyImages = {
  child: '/images/kelly/child-kelly.webp',
  teen: '/images/kelly/teen-kelly.webp',
  adult: '/images/kelly/adult-kelly.webp',
  senior: '/images/kelly/senior-kelly.webp',
};
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero-grid">
      <!-- Left: Text and CTA -->
      <div class="hero-content">
        <h1 class="hero-title">{dictionary.hero.title}</h1>
        <p class="hero-subtitle">{dictionary.hero.subtitle}</p>
        
        <div class="hero-benefits">
          <div class="benefit">
            <span class="benefit-icon">✓</span>
            <span>Just 8 minutes a day</span>
          </div>
          <div class="benefit">
            <span class="benefit-icon">✓</span>
            <span>Whole family learns together</span>
          </div>
          <div class="benefit">
            <span class="benefit-icon">✓</span>
            <span>365 universal lessons for 2026</span>
          </div>
        </div>

        <div class="hero-cta">
          <a href="/checkout" class="btn-primary">
            Start Your 7-Day Free Trial
          </a>
          <p class="cta-fine-print">No credit card required • Cancel anytime</p>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <strong>$4.99</strong>
            <span>/month</span>
          </div>
          <div class="stat">
            <strong>$49.99</strong>
            <span>/year (save $10)</span>
          </div>
        </div>
      </div>

      <!-- Right: Kelly Image -->
      <div class="hero-image">
        <img 
          src={kellyImages[audienceType]} 
          alt="Curious Kelly - Your learning companion"
          width="600"
          height="800"
          loading="eager"
        />
        <div class="kelly-greeting">
          <p>👋 Hi! I'm Kelly, your guide to learning something new every day.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    overflow: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    opacity: 0.95;
    margin-bottom: 2rem;
    line-height: 1.4;
  }

  .hero-benefits {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .benefit {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.125rem;
  }

  .benefit-icon {
    background: rgba(255, 255, 255, 0.3);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .hero-cta {
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 1.25rem 3rem;
    background: white;
    color: #667eea;
    border-radius: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  .cta-fine-print {
    margin-top: 1rem;
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat strong {
    font-size: 2rem;
    font-weight: 700;
  }

  .stat span {
    font-size: 1rem;
    opacity: 0.9;
  }

  .hero-image {
    position: relative;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    border-radius: 2rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  .kelly-greeting {
    position: absolute;
    bottom: -1rem;
    left: -1rem;
    background: white;
    color: #1e293b;
    padding: 1rem 1.5rem;
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    max-width: 300px;
  }

  .kelly-greeting p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (max-width: 968px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .hero-image {
      order: -1;
    }

    .kelly-greeting {
      position: static;
      margin-top: 1rem;
    }
  }
</style>





