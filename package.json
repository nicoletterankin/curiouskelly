{
  "name": "daily-lesson-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Production-grade backend platform for daily lessons and hourly live classes.",
  "scripts": {
    "serve": "npx serve public -l 3000",
    "dev": "pnpm run dev:stack",
    "dev:gateway": "pnpm --filter \"@acme/gateway\" run dev",
    "dev:classroom": "pnpm --filter \"@acme/classroom\" run dev",
    "dev:stack": "pnpm --parallel --workspace-concurrency=4 --filter \"@acme/gateway\" --filter \"@acme/classroom\" run dev",
    "build": "echo skip",
    "vercel-build": "echo skip",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "eval": "npx ts-node evals/run-all.ts",
    "eval:voice": "npx ts-node evals/kelly-voice-eval.ts",
    "eval:lifetime": "npx ts-node evals/lifetime-experience-eval.ts",
    "test:unit": "pnpm --dir tests run test:unit",
    "test:integration": "pnpm --dir tests run test:integration",
    "test:e2e": "pnpm --dir tests run test:e2e",
    "test:load": "pnpm --dir tests run test:load",
    "test:all": "pnpm --dir tests run test:all",
    "prisma:generate": "pnpm --filter prisma-client run generate",
    "prepare": "husky install",
    "setup:env": "node scripts/setup-env.js",
    "check:progress": "node scripts/check-progress.js",
    "deploy": "bash scripts/quick-deploy.sh",
    "build:seo": "node scripts/build-seo.js",
    "slop:detect": "npx ts-node scripts/slop-detector.ts",
    "slop:report": "npx ts-node scripts/slop-detector.ts --report-only",
    "audit:lessons": "node scripts/audit_lessons.js",
    "headlines:preview": "npx ts-node scripts/fix-headlines.ts --preview",
    "headlines:preview-10": "npx ts-node scripts/fix-headlines.ts --preview --count=10",
    "headlines:fix-day": "npx ts-node scripts/fix-headlines.ts --fix-day",
    "headlines:fix": "npx ts-node scripts/fix-headlines.ts --fix",
    "visuals:dry-run": "npx ts-node scripts/generate-all-phase-visuals.ts --dry-run",
    "visuals:day": "npx ts-node scripts/generate-all-phase-visuals.ts --day",
    "visuals:range": "npx ts-node scripts/generate-all-phase-visuals.ts --range",
    "visuals:missing": "npx ts-node scripts/generate-all-phase-visuals.ts --missing",
    "visuals:all": "npx ts-node scripts/generate-all-phase-visuals.ts --all",
    "atoms:preview": "npx ts-node scripts/update-atom-visual-urls.ts --preview",
    "atoms:update": "npx ts-node scripts/update-atom-visual-urls.ts --update",
    "factory:check": "npx tsx scripts/lesson-factory/preflight-check.ts",
    "factory:day": "npx tsx scripts/lesson-factory/unified-factory.ts --day",
    "factory:range": "npx tsx scripts/lesson-factory/unified-factory.ts --from",
    "factory:dry-run": "npx tsx scripts/lesson-factory/unified-factory.ts --dry-run --day"
  },
  "engines": {
    "node": ">=20.11.1",
    "pnpm": ">=9.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.940.0",
    "@fal-ai/client": "^1.7.2",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.86.0",
    "@vercel/node": "^3.2.0",
    "dotenv": "^17.2.3",
    "replicate": "^1.4.0",
    "stripe": "^14.25.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/node": "^20.11.30",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "openai": "^6.10.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "puppeteer": "^24.31.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "ws": "^8.18.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cts,mts}": "pnpm exec eslint --fix",
    "*.{json,md,yml,yaml}": "pnpm exec prettier --write"
  }
}
