---
/**
 * PhaseComments Component
 * 
 * Displays per-phase comments on lesson content with ability to:
 * - View approved comments for the current phase
 * - Add new comments (insight, question, suggestion, experience)
 * - Upvote helpful comments
 * - Report inappropriate content
 */

interface Props {
  lessonDay: number;
  lessonYear?: number;
  phase: 'hook' | 'cliff' | 'fact1' | 'fact2' | 'fact3' | 'wisdom' | 'outro';
  collapsed?: boolean;
}

const { lessonDay, lessonYear = 1, phase, collapsed = true } = Astro.props;
---

<div class="phase-comments" data-lesson-day={lessonDay} data-lesson-year={lessonYear} data-phase={phase}>
  <button class="comments-toggle" aria-expanded={!collapsed}>
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span class="comments-count">...</span>
    <span class="toggle-text">Comments</span>
  </button>
  
  <div class="comments-panel" hidden={collapsed}>
    <div class="comments-header">
      <h3>Community Insights</h3>
      <p class="phase-label">{phase.charAt(0).toUpperCase() + phase.slice(1)} Phase</p>
    </div>
    
    <div class="comments-list" role="list">
      <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading comments...</p>
      </div>
    </div>
    
    <div class="add-comment-section">
      <button class="add-comment-btn" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Share Your Insight
      </button>
      
      <form class="comment-form" hidden>
        <div class="comment-type-selector">
          <label class="type-option">
            <input type="radio" name="comment-type" value="insight" checked>
            <span class="type-label">💡 Insight</span>
          </label>
          <label class="type-option">
            <input type="radio" name="comment-type" value="question">
            <span class="type-label">❓ Question</span>
          </label>
          <label class="type-option">
            <input type="radio" name="comment-type" value="experience">
            <span class="type-label">📖 Experience</span>
          </label>
          <label class="type-option">
            <input type="radio" name="comment-type" value="suggestion">
            <span class="type-label">💭 Suggestion</span>
          </label>
        </div>
        
        <textarea 
          name="content" 
          placeholder="Share your thoughts on this part of the lesson..."
          minlength="10"
          maxlength="2000"
          rows="4"
          required
        ></textarea>
        
        <div class="form-footer">
          <span class="char-count">0 / 2000</span>
          <div class="form-actions">
            <button type="button" class="cancel-btn">Cancel</button>
            <button type="submit" class="submit-btn">Post Comment</button>
          </div>
        </div>
      </form>
    </div>
    
    <div class="auth-prompt" hidden>
      <p>Sign in to join the conversation</p>
      <a href="/login" class="sign-in-btn">Sign In</a>
    </div>
  </div>
</div>

<style>
  .phase-comments {
    margin-top: 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .comments-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    font-size: 0.9rem;
    opacity: 0.7;
    transition: opacity 0.2s, background 0.2s;
  }

  .comments-toggle:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.05);
  }

  .comments-toggle .icon {
    width: 18px;
    height: 18px;
  }

  .comments-count {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.125rem 0.5rem;
    border-radius: 10px;
    font-size: 0.8rem;
    min-width: 1.5rem;
    text-align: center;
  }

  .comments-panel {
    padding: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .comments-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .comments-header h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .phase-label {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .comments-list {
    max-height: 400px;
    overflow-y: auto;
    margin-bottom: 1rem;
  }

  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2rem;
    opacity: 0.6;
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .comment-card {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }

  .comment-card:last-child {
    margin-bottom: 0;
  }

  .comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .comment-type-badge {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 4px;
    background: rgba(233, 69, 96, 0.2);
    color: #ff6b6b;
  }

  .comment-time {
    font-size: 0.75rem;
    opacity: 0.5;
  }

  .comment-content {
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .comment-actions {
    display: flex;
    gap: 1rem;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    background: transparent;
    border: none;
    color: inherit;
    opacity: 0.6;
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: opacity 0.2s, background 0.2s;
  }

  .action-btn:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.1);
  }

  .action-btn.upvoted {
    color: #e94560;
    opacity: 1;
  }

  .add-comment-section {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1rem;
  }

  .add-comment-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(233, 69, 96, 0.1);
    border: 1px dashed rgba(233, 69, 96, 0.3);
    border-radius: 8px;
    color: #ff6b6b;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .add-comment-btn:hover {
    background: rgba(233, 69, 96, 0.2);
    border-color: rgba(233, 69, 96, 0.5);
  }

  .add-comment-btn svg {
    width: 18px;
    height: 18px;
  }

  .comment-form {
    margin-top: 1rem;
  }

  .comment-type-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .type-option {
    cursor: pointer;
  }

  .type-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .type-label {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    font-size: 0.85rem;
    transition: background 0.2s;
  }

  .type-option input:checked + .type-label {
    background: rgba(233, 69, 96, 0.3);
  }

  .type-option:hover .type-label {
    background: rgba(255, 255, 255, 0.2);
  }

  .comment-form textarea {
    width: 100%;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: inherit;
    font-family: inherit;
    font-size: 0.95rem;
    resize: vertical;
  }

  .comment-form textarea:focus {
    outline: none;
    border-color: #e94560;
  }

  .form-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.75rem;
  }

  .char-count {
    font-size: 0.8rem;
    opacity: 0.5;
  }

  .form-actions {
    display: flex;
    gap: 0.5rem;
  }

  .cancel-btn,
  .submit-btn {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: none;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .cancel-btn {
    background: transparent;
    color: inherit;
    opacity: 0.7;
  }

  .cancel-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    opacity: 1;
  }

  .submit-btn {
    background: #e94560;
    color: white;
  }

  .submit-btn:hover {
    background: #ff6b6b;
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .auth-prompt {
    text-align: center;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
  }

  .auth-prompt p {
    margin: 0 0 1rem 0;
    opacity: 0.7;
  }

  .sign-in-btn {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    background: #e94560;
    color: white;
    text-decoration: none;
    border-radius: 20px;
    font-weight: 500;
    transition: background 0.2s;
  }

  .sign-in-btn:hover {
    background: #ff6b6b;
  }

  .empty-state {
    text-align: center;
    padding: 2rem;
    opacity: 0.6;
  }

  .empty-state p {
    margin: 0;
  }

  .featured-badge {
    background: linear-gradient(135deg, #ffd700, #ffaa00);
    color: #1a1a2e;
  }
</style>

<script>
  class PhaseCommentsController {
    constructor(element: HTMLElement) {
      this.element = element;
      this.lessonDay = parseInt(element.dataset.lessonDay || '1');
      this.lessonYear = parseInt(element.dataset.lessonYear || '1');
      this.phase = element.dataset.phase || 'hook';
      
      this.init();
    }

    element: HTMLElement;
    lessonDay: number;
    lessonYear: number;
    phase: string;
    isAuthenticated: boolean = false;

    init() {
      this.bindEvents();
      this.loadComments();
    }

    bindEvents() {
      // Toggle panel
      const toggle = this.element.querySelector('.comments-toggle');
      toggle?.addEventListener('click', () => this.togglePanel());

      // Add comment button
      const addBtn = this.element.querySelector('.add-comment-btn');
      addBtn?.addEventListener('click', () => this.showForm());

      // Cancel button
      const cancelBtn = this.element.querySelector('.cancel-btn');
      cancelBtn?.addEventListener('click', () => this.hideForm());

      // Form submission
      const form = this.element.querySelector('.comment-form');
      form?.addEventListener('submit', (e) => this.submitComment(e));

      // Character count
      const textarea = this.element.querySelector('textarea');
      textarea?.addEventListener('input', () => this.updateCharCount());
    }

    togglePanel() {
      const panel = this.element.querySelector('.comments-panel');
      const toggle = this.element.querySelector('.comments-toggle');
      
      if (panel && toggle) {
        const isHidden = panel.hasAttribute('hidden');
        if (isHidden) {
          panel.removeAttribute('hidden');
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          panel.setAttribute('hidden', '');
          toggle.setAttribute('aria-expanded', 'false');
        }
      }
    }

    showForm() {
      const addBtn = this.element.querySelector('.add-comment-btn');
      const form = this.element.querySelector('.comment-form');
      
      if (addBtn && form) {
        addBtn.setAttribute('hidden', '');
        form.removeAttribute('hidden');
        form.querySelector('textarea')?.focus();
      }
    }

    hideForm() {
      const addBtn = this.element.querySelector('.add-comment-btn');
      const form = this.element.querySelector('.comment-form') as HTMLFormElement;
      
      if (addBtn && form) {
        form.setAttribute('hidden', '');
        form.reset();
        addBtn.removeAttribute('hidden');
        this.updateCharCount();
      }
    }

    updateCharCount() {
      const textarea = this.element.querySelector('textarea') as HTMLTextAreaElement;
      const charCount = this.element.querySelector('.char-count');
      
      if (textarea && charCount) {
        const count = textarea.value.length;
        charCount.textContent = `${count} / 2000`;
      }
    }

    async loadComments() {
      const listEl = this.element.querySelector('.comments-list');
      if (!listEl) return;

      try {
        // In a real implementation, this would call Supabase
        // For now, show empty state
        listEl.innerHTML = `
          <div class="empty-state">
            <p>Be the first to share your thoughts on this phase!</p>
          </div>
        `;

        // Update count
        const countEl = this.element.querySelector('.comments-count');
        if (countEl) countEl.textContent = '0';

      } catch (error) {
        console.error('Error loading comments:', error);
        listEl.innerHTML = `
          <div class="empty-state">
            <p>Unable to load comments</p>
          </div>
        `;
      }
    }

    async submitComment(e: Event) {
      e.preventDefault();
      
      const form = e.target as HTMLFormElement;
      const formData = new FormData(form);
      
      const content = formData.get('content') as string;
      const commentType = formData.get('comment-type') as string;

      if (!content || content.length < 10) {
        alert('Please enter at least 10 characters');
        return;
      }

      const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting...';

      try {
        // In a real implementation, this would call Supabase
        console.log('Submitting comment:', {
          lessonDay: this.lessonDay,
          lessonYear: this.lessonYear,
          phase: this.phase,
          commentType,
          content
        });

        // Simulate success
        await new Promise(resolve => setTimeout(resolve, 500));
        
        this.hideForm();
        this.loadComments();
        
        // Show success message
        alert('Comment submitted for review!');

      } catch (error) {
        console.error('Error submitting comment:', error);
        alert('Failed to submit comment. Please try again.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Post Comment';
      }
    }

    renderComment(comment: any): string {
      const typeLabels: Record<string, string> = {
        insight: '💡 Insight',
        question: '❓ Question',
        experience: '📖 Experience',
        suggestion: '💭 Suggestion'
      };

      return `
        <div class="comment-card" data-comment-id="${comment.id}">
          <div class="comment-header">
            <span class="comment-type-badge ${comment.moderation_status === 'featured' ? 'featured-badge' : ''}">
              ${typeLabels[comment.comment_type] || comment.comment_type}
            </span>
            <span class="comment-time">${this.formatTime(comment.created_at)}</span>
          </div>
          <p class="comment-content">${this.escapeHtml(comment.content)}</p>
          <div class="comment-actions">
            <button class="action-btn upvote-btn" data-comment-id="${comment.id}">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 19V5M5 12l7-7 7 7"/>
              </svg>
              ${comment.upvotes}
            </button>
            <button class="action-btn reply-btn" data-comment-id="${comment.id}">
              Reply (${comment.reply_count})
            </button>
          </div>
        </div>
      `;
    }

    formatTime(dateStr: string): string {
      const date = new Date(dateStr);
      const now = new Date();
      const diff = now.getTime() - date.getTime();
      
      const minutes = Math.floor(diff / 60000);
      const hours = Math.floor(diff / 3600000);
      const days = Math.floor(diff / 86400000);
      
      if (minutes < 1) return 'Just now';
      if (minutes < 60) return `${minutes}m ago`;
      if (hours < 24) return `${hours}h ago`;
      if (days < 30) return `${days}d ago`;
      return date.toLocaleDateString();
    }

    escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  }

  // Initialize all phase comment components
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.phase-comments').forEach(el => {
      new PhaseCommentsController(el as HTMLElement);
    });
  });
</script>
