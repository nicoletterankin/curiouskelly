---
/**
 * Commons Page
 * 
 * Community hub for browsing learner contributions,
 * featured insights, and curriculum suggestions.
 */
import CommonsPanel from '../components/CommonsPanel.astro';

const title = 'The Commons — Curious Kelly';
const description = 'Community insights and curriculum contributions from Curious Kelly learners';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      min-height: 100vh;
      color: white;
    }

    .page-container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .site-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 2rem;
      background: rgba(0, 0, 0, 0.2);
    }

    .site-nav .logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: white;
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
    }

    .site-nav .logo span {
      font-size: 1.5rem;
    }

    .nav-links {
      display: flex;
      gap: 1.5rem;
    }

    .nav-links a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: white;
    }

    .nav-links a.active {
      color: #e94560;
    }

    main {
      flex: 1;
      padding: 2rem 1rem;
    }

    footer {
      text-align: center;
      padding: 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.9rem;
      opacity: 0.6;
    }

    footer a {
      color: #e94560;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="page-container">
    <nav class="site-nav">
      <a href="/" class="logo">
        <span>✨</span>
        Curious Kelly
      </a>
      <div class="nav-links">
        <a href="/calendar">Calendar</a>
        <a href="/commons" class="active">Commons</a>
        <a href="/account">Account</a>
      </div>
    </nav>

    <main>
      <CommonsPanel initialTab="recent" />
    </main>

    <footer>
      <p>✨ <a href="/">Curious Kelly</a> — Daily learning for lifelong curiosity</p>
      <p style="margin-top: 0.5rem;">© 2025 Lesson of the Day PBC</p>
    </footer>
  </div>
</body>
</html>
