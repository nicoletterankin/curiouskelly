# Kelly OS Environment Variables Template
# Copy this to .env.local and fill in your values
# NEVER commit .env files to git

# ============================================
# SUPABASE (Database, Auth, Storage)
# ============================================
PUBLIC_SUPABASE_URL=https://tvjalxxsyryjphkforjv.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# ELEVENLABS (TTS & Conversational AI)
# ============================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_KELLY_VOICE_ID=wAdymQH5YucAkXwmrdL0

# ============================================
# STRIPE (Payments)
# ============================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# ============================================
# SYNC LABS (Video Lip-Sync)
# ============================================
SYNC_LABS_API_KEY=your_sync_labs_api_key_here

# ============================================
# REPLICATE (Image/Video Generation)
# ============================================
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ============================================
# HUGGINGFACE (Optional - LoRA Models)
# ============================================
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ============================================
# VERCEL (Edge Config, KV, Blob)
# ============================================
EDGE_CONFIG_SYNC_SECRET=your_edge_config_sync_secret
VERCEL_KV_REST_API_URL=your_kv_url
VERCEL_KV_REST_API_TOKEN=your_kv_token
BLOB_READ_WRITE_TOKEN=your_blob_token

# ============================================
# RESEND (Email)
# ============================================
RESEND_API_KEY=re_your_resend_api_key

# ============================================
# ANALYTICS (Optional)
# ============================================
ANALYTICS_ID=your_analytics_id
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# CLOUDFLARE (Legacy - Migrating Away)
# ============================================
# CLOUDFLARE_API_TOKEN=your_cloudflare_token
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret

# ============================================
# APPLICATION CONFIG
# ============================================
NODE_ENV=production
PUBLIC_SITE_URL=https://curiouskelly.com
PUBLIC_DEFAULT_LOCALE=en-US
PUBLIC_AVAILABLE_LOCALES=en-US,es-ES,pt-BR

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
ENABLE_CONVERSATIONAL_AI=true
ENABLE_COMMUNITY_NOTES=true
ENABLE_OFFLINE_MODE=false

# ============================================
# RATE LIMITING (Optional)
# ============================================
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================
# NOTES
# ============================================
# - Supabase keys: Get from Supabase Dashboard → Settings → API
# - ElevenLabs: Get from ElevenLabs Dashboard → Profile → API Keys
# - Stripe: Get from Stripe Dashboard → Developers → API Keys
# - Sync Labs: Get from Sync Labs Dashboard → API Keys
# - Replicate: Get from Replicate Dashboard → Account → API Tokens
# - Vercel: Get from Vercel Dashboard → Project → Settings → Environment Variables





