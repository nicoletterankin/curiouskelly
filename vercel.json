{
  "version": 2,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "framework": null,
  "headers": [
    {
      "source": "/unity/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
