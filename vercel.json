{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node scripts/build-seo.js",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/learn.html", "permanent": true },
    { "source": "/calendar.html", "destination": "/learn.html?tab=journey&subtab=calendar", "permanent": true },
    { "source": "/curriculum.html", "destination": "/learn.html?tab=journey&subtab=curriculum", "permanent": true },
    { "source": "/pricing.html", "destination": "/learn.html?tab=settings&section=subscription", "permanent": true },
    { "source": "/about.html", "destination": "/learn.html?tab=settings&section=about", "permanent": true },
    { "source": "/settings.html", "destination": "/learn.html?tab=settings", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/learn.html" },
    { "source": "/day/:number", "destination": "/api/day/:number" },
    { "source": "/og/:day", "destination": "/api/og/:day" },
    { "source": "/learn", "destination": "/learn.html" },
    { "source": "/curriculum", "destination": "/learn.html?tab=journey&subtab=curriculum" },
    { "source": "/calendar", "destination": "/learn.html?tab=journey&subtab=calendar" },
    { "source": "/pricing", "destination": "/learn.html?tab=settings&section=subscription" },
    { "source": "/about", "destination": "/learn.html?tab=settings&section=about" },
    { "source": "/commons", "destination": "/commons.html" },
    { "source": "/compare", "destination": "/compare-us.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/gifts", "destination": "/gifts.html" },
    { "source": "/enterprise", "destination": "/enterprise.html" },
    { "source": "/careers", "destination": "/share.html" },
    { "source": "/share", "destination": "/share.html" },
    { "source": "/affiliates", "destination": "/share.html#earn" },
    { "source": "/newsroom", "destination": "/newsroom.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/settings", "destination": "/learn.html?tab=settings" },
    { "source": "/goldenv5", "destination": "/golden-v5.html" },
    { "source": "/kelly-reference", "destination": "/kelly-hair-reference-for-arif.html" },
    { "source": "/arif", "destination": "/kelly-hair-reference-for-arif.html" },
    { "source": "/submission/:id", "destination": "/submission.html" },
    { "source": "/mission-control", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/motion-progress", "destination": "/admin/motion-progress.html" },
    { "source": "/admin/visual-gallery", "destination": "/admin/visual-gallery.html" },
    { "source": "/visual-gallery", "destination": "/admin/visual-gallery.html" },
    { "source": "/stripe-wizard", "destination": "/stripe-wizard.html" },
    { "source": "/stripe-setup", "destination": "/stripe-wizard.html" },
    { "source": "/lesson/:day", "destination": "/learn.html?day=:day" }
  ],
  "headers": [
    {
      "source": "/assets/kelly/kelly-personas-manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/test-:path(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/debug-:path(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/mockups/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/:path*.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/:path*.:ext(js|css|woff|woff2|ttf|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/:path*.:ext(png|jpg|jpeg|gif|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/og/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/day/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-lesson",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/daily-push-notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/birthday-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/gentle-return",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cfo/daily-snapshot",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/clear-commissions",
      "schedule": "0 6 * * *"
    }
  ]
}
