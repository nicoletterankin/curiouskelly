{
  "version": 2,
  "rewrites": [
    {
      "source": "/unity/(.*)",
      "destination": "/daily-lesson-marketing/dist/unity/$1"
    },
    {
      "source": "/lessons/(.*)",
      "destination": "/daily-lesson-marketing/dist/lessons/$1"
    },
    {
      "source": "/lesson-player/(.*)",
      "destination": "/daily-lesson-marketing/dist/lesson-player/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/daily-lesson-marketing/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ]
}