{
  "version": 2,
  "public": true,
  "framework": null,
  "installCommand": "echo skip-install",
  "buildCommand": "echo skip-build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.2.0",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/day/:number", "destination": "/api/day/:number" },
    { "source": "/og/:day", "destination": "/api/og/:day" },
    { "source": "/learn", "destination": "/learn.html" },
    { "source": "/curriculum", "destination": "/curriculum.html" },
    { "source": "/pricing", "destination": "/pricing.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/commons", "destination": "/commons.html" },
    { "source": "/compare", "destination": "/compare-us.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/gifts", "destination": "/gifts.html" },
    { "source": "/enterprise", "destination": "/enterprise.html" },
    { "source": "/careers", "destination": "/share.html" },
    { "source": "/share", "destination": "/share.html" },
    { "source": "/affiliates", "destination": "/share.html#earn" },
    { "source": "/newsroom", "destination": "/newsroom.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/calendar", "destination": "/calendar.html" },
    { "source": "/settings", "destination": "/settings.html" },
    { "source": "/goldenv5", "destination": "/golden-v5.html" },
    { "source": "/kelly-reference", "destination": "/kelly-hair-reference-for-arif.html" },
    { "source": "/arif", "destination": "/kelly-hair-reference-for-arif.html" },
    { "source": "/submission/:id", "destination": "/submission.html" },
    { "source": "/mission-control", "destination": "/admin/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|ttf|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/day/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-lesson",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/daily-push-notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/birthday-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/gentle-return",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cfo/daily-snapshot",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/clear-commissions",
      "schedule": "0 6 * * *"
    }
  ]
}
