{
  "version": 2,
  "public": true,
  "buildCommand": "echo skip",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@3.2.0"
    }
  },
  "rewrites": [
    { "source": "/day/:number", "destination": "/api/day/:number" },
    { "source": "/og/:day", "destination": "/api/og/:day" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-lesson",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/birthday-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/gentle-return",
      "schedule": "0 18 * * *"
    }
  ]
}
