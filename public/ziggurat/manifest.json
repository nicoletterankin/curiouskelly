  "renderingPipeline": {
    "description": "6-layer photorealistic LED compositing",
    "layers": [
      {
        "order": 1,
        "name": "Night Grading",
        "technique": "Multiply + Overlay composite modes",
        "purpose": "Transform daylight photo to night scene"
      },
      {
        "order": 2,
        "name": "Atmospheric Scatter",
        "technique": "Radial gradient with screen blending",
        "purpose": "Simulate light scatter in atmosphere"
      },
      {
        "order": 3,
        "name": "Multi-pass Bloom",
        "technique": "6 shadow blur passes (80px-20px)",
        "purpose": "Create realistic LED glow falloff"
      },
      {
        "order": 4,
        "name": "Core LED Strip",
        "technique": "Linear gradient fill with brightness boost",
        "purpose": "Sharp, bright LED source"
      },
      {
        "order": 5,
        "name": "White-hot Center",
        "technique": "Two-pass stroke with varying width",
        "purpose": "Overexposed center typical of bright LEDs"
      },
      {
        "order": 6,
        "name": "Surface Spill",
        "technique": "Gradient fills above and below",
        "purpose": "Light bouncing off building surfaces"
      },
      {
        "order": 7,
        "name": "Sky Glow",
        "technique": "Large radial gradient above building",
        "purpose": "Atmospheric illumination / light pollution"
      },
      {
        "order": 8,
        "name": "Atmosphere",
        "technique": "Vignette + film grain",
        "purpose": "Cinematic authenticity"
      }
    ]
  },
  
