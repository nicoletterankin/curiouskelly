  "headline": {
    "en": "Percentages are fractions with a common denominator—making comparison effortless",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "universal_truth": {
    "en": "Common standards make comparison possible; without them, we're comparing apples to oranges",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "fun_facts": [
    {
      "en": "The word 'percent' comes from Latin 'per centum'—literally 'by the hundred'",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "The % symbol evolved from an abbreviation of 'per 100' written as 'p cento' then 'pc' then '%'",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Percentages over 100% make sense—200% means twice as much as the original",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
  ],
