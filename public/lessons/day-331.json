    "pt": "[NEEDS TRANSLATION]"
  },
  "fun_facts": [
    {
      "en": "Every right implies a corresponding responsibility—freedom of speech requires responsible speech",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Responsibility comes from the Latin 'respondere'—to respond or answer",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Mature societies balance individual rights with collective responsibilities",
