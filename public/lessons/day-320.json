      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Healthy consent is enthusiastic, informed, and freely revocable at any time",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
