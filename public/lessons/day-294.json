  "headline": {
    "en": "Evidence is the basis for knowledge—what we see, measure, and verify about reality",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "universal_truth": {
    "en": "Claims without evidence are opinions; the strength of your belief should match the strength of your evidence",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "fun_facts": [
    {
      "en": "Scientists require evidence to be reproducible—others must be able to get the same results",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Anecdotes are the weakest form of evidence—one case doesn't prove a pattern",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Confirmation bias leads us to notice evidence for what we already believe and ignore evidence against",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
  ],
  "discussion_questions": [
    {
      "en": "How do you evaluate evidence for claims you hear?",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "What do you believe without good evidence?",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "How do you distinguish between strong and weak evidence?",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
  ],
