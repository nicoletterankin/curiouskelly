        "pt": "[NEEDS TRANSLATION]"
      },
      "duration": {
        "en": 14,
        "es": 16,
        "pt": 15
      },
      "prompt": {
        "en": "How do we evaluate claims?",
        "es": "[NEEDS TRANSLATION]",
        "pt": "[NEEDS TRANSLATION]"
      },
      "options": [
        {
          "letter": "A",
          "text": {
            "en": "Claims should be proportional to evidence—extraordinary claims require extraordinary evidence; the strength of belief should match the quality and quantity of supporting evidence",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          },
          "quality": "best",
          "response": {
            "en": "Yes. A claim that it will rain tomorrow needs modest evidence. A claim that aliens visited needs extraordinary evidence. Match confidence to evidence quality.",
