        "pt": "[NEEDS TRANSLATION]"
      },
      "duration": {
        "en": 14,
        "es": 16,
        "pt": 15
      },
      "prompt": {
        "en": "What makes teaching effective?",
        "es": "[NEEDS TRANSLATION]",
        "pt": "[NEEDS TRANSLATION]"
      },
      "options": [
        {
          "letter": "A",
          "text": {
            "en": "Effective teaching starts from where the learner is, builds on what they already know, uses multiple approaches, and checks for understanding",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          },
          "quality": "best",
          "response": {
            "en": "Yes. Teaching isn't about displaying knowledge—it's about bridging from what someone knows to what they don't. The learner's state, not the teacher's knowledge, is the starting point.",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          }
        },
        {
          "letter": "B",
          "text": {
            "en": "Knowing the subject deeply makes you a good teacher",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          },
          "quality": "good",
          "response": {
            "en": "Expertise helps, but many experts can't teach—understanding transmission requires different skills...",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          }
        }
      ]
    },
