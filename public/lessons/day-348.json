      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "What if those beliefs are wrong?",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
