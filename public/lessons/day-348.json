      "options": [
        {
          "letter": "A",
          "text": {
            "en": "I want to learn something new",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          },
          "quality": "best",
          "response": {
            "en": "Perfect. Curiosity is the first step to understanding. Let's explore this together.",
