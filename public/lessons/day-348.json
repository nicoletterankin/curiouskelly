  "headline": {
    "en": "Fixed mindset believes abilities are static—that talent is all and effort won't help",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "universal_truth": {
    "en": "What you believe about your ability to change affects whether you try",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "fun_facts": [
    {
      "en": "Fixed mindset often develops from being praised for talent rather than effort",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "People with fixed mindsets give up faster when faced with difficulty",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Fixed mindset is a belief, not reality—it can be changed",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
  ],
  "discussion_questions": [
    {
      "en": "Where do you believe you can't change?",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
