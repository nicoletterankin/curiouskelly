    "pt": "[NEEDS TRANSLATION]"
  },
  "fun_facts": [
    {
      "en": "Most experts recommend having at least 72 hours of supplies ready for emergencies",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "People with emergency plans respond faster and more effectively during crises",
