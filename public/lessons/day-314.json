          "text": {
            "en": "Preparation gives peace of mind",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          },
          "quality": "good",
          "response": {
            "en": "Peace of mind matters, but the practical benefit is having options when you need them...",
