      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Preparation reduces both the objective danger and the subjective panic during emergencies",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
