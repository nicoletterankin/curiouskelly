      "prompt": {
        "en": "Why prepare in advance?",
        "es": "[NEEDS TRANSLATION]",
        "pt": "[NEEDS TRANSLATION]"
      },
      "options": [
        {
          "letter": "A",
          "text": {
            "en": "Preparation in calm times creates options in crisis—you can't buy insurance after the accident; readiness gives you resources when acquiring resources is impossible",
            "es": "[NEEDS TRANSLATION]",
            "pt": "[NEEDS TRANSLATION]"
          },
          "quality": "best",
          "response": {
            "en": "Yes. During crisis, there's no time to prepare—only time to execute. What you prepared before determines what options you have during. Prepare while you can, not while you must.",
