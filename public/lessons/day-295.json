  "headline": {
    "en": "Hypotheses are testable predictions—educated guesses that can be proven right or wrong",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "universal_truth": {
    "en": "Ideas that can't be tested can't be improved; make your beliefs falsifiable",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "fun_facts": [
    {
      "en": "A good hypothesis must be falsifiable—there must be a possible result that would prove it wrong",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Einstein's relativity made specific predictions that could have disproven it—they didn't",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Many business ideas fail because they were never tested as hypotheses before full commitment",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
  ],
  "discussion_questions": [
