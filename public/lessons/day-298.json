    "pt": "[NEEDS TRANSLATION]"
  },
  "universal_truth": {
    "en": "Data doesn't speak for itself; interpretation is where meaning comes from—and where bias enters",
    "es": "[NEEDS TRANSLATION]",
    "pt": "[NEEDS TRANSLATION]"
  },
  "fun_facts": [
    {
      "en": "The same data can support different interpretations depending on framework used",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Pre-existing beliefs strongly influence how we interpret new evidence",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    },
    {
      "en": "Scientists often disagree about what results mean even when they agree on the data",
      "es": "[NEEDS TRANSLATION]",
      "pt": "[NEEDS TRANSLATION]"
    }
  ],
  "discussion_questions": [
