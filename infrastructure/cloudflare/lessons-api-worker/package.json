{
  "name": "curiouskelly-lessons-worker",
  "version": "1.0.0",
  "description": "Cloudflare D1 lessons API - Supabase mirror for redundancy",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "d1:create": "wrangler d1 create kelly-lessons-mirror",
    "d1:schema": "wrangler d1 execute kelly-lessons-mirror --file=./schema.sql",
    "d1:schema-local": "wrangler d1 execute kelly-lessons-mirror --local --file=./schema.sql",
    "d1:list": "wrangler d1 list",
    "d1:info": "wrangler d1 info kelly-lessons-mirror",
    "tail": "wrangler tail"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "curiouskelly",
    "lessons"
  ],
  "author": "Lesson of the Day PBC",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}

